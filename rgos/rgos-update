#!/usr/bin/env python3
"""RG OS offline updater.

Put an update tar made by `./build.sh update` into the `update/` folder of any exFAT / FAT / ext4 partition (normally the
ROMS partition of the SD card). On the next boot rgos-session runs `rgos-update boot` before the menu starts: it finds the
tar, checks it, replaces the files on the FAT boot partition and reboots into the new system.

Tar layout (made by tools/mkupdate.py, i.e. `./build.sh update`):
  manifest.json                     {"format": 1, "id": "...", "device": "rg-rotate" | "rg34xxsp" | "rg35xxh" | "rg35xxsp" | "miniloong", "files": {"SYSTEM": "<sha256>", ...}}
  boot/SYSTEM                       the Debian squashfs (the RG OS system itself)
  boot/SYSTEM.md5                   its md5 line (only if the card has one)
  boot/rgos-initrd.cpio             the RG OS initramfs
  boot/KERNEL, boot/KERNEL.md5, boot/extlinux/extlinux.conf     optional
  boot/device_trees/ums512-rg-rotate.dtb (RG Rotate), boot/dtb.img (RG34XXSP, RG35XX H, RG35XX SP), boot/miniloong.dtb or boot/device_trees/miniloong.dtb (MiniLoong Pocket 1)   optional
Only those exact file names are ever written, and only inside the boot partition.

Safety:
  * every file is staged as <name>.new, fsynced and verified against its SHA-256 BEFORE anything is replaced;
  * a bad tar, wrong device, wrong checksum, too little free space, ... leaves the boot partition untouched;
  * small boot partitions: when the new SYSTEM cannot be staged next to the old one (old + new would not fit), the whole tar is
    first verified by streaming it (nothing is written), then the old copy of the files that do not fit is deleted right before
    the new one is written (no .prev for those). The tar stays on the card until the update has finished, so a power cut
    can be repaired by running the update again from a PC copy of the same files;
  * files are replaced by renaming (no 500 MB copies): the old file becomes <name>.prev, the verified <name>.new takes its place,
    and any failure renames everything back (manual rollback from a PC: rename <name>.prev over <name>). Only after the whole
    update is installed are the <name>.prev copies deleted, so no old files are left taking up space on the boot partition;
  * the tar is renamed to <name>.applied / <name>.failed afterwards so it never runs twice, and the installed build id is
    stored in rgos-update.id on the boot partition (an update with the same id is skipped);
  * a result line is appended to update/rgos-update.log on the card. Details: /var/log/rgos-update.log.

Commands:
  boot                  locate boot partition + update tar and apply it (called by rgos-session)
  apply TAR BOOTDIR     apply one tar to an already mounted boot partition (manual use / tests)
Exit status: 10 = update installed, reboot now; 0 = nothing to do, or the update failed (boot continues normally).
"""
import hashlib, json, os, posixpath, re, shutil, subprocess, sys, tarfile, time

BOOT_FILES = ("device_trees/ums512-rg-rotate.dtb", "device_trees/miniloong.dtb", "miniloong.dtb", "dtb.img", "KERNEL", "KERNEL.md5", "rgos-initrd.cpio", "SYSTEM", "SYSTEM.md5",
              "extlinux/extlinux.conf")
ID_FILE = "rgos-update.id"
UPD_DIR = "update"
FORMAT = 1
MARGIN = 2 << 20
ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
TAR_RE = re.compile(r"\.(tar|tar\.gz|tgz)$", re.I)
RUN = os.environ.get("RGOS_UPDATE_RUN", "/run/rgos/update")
LOG_FILE = os.environ.get("RGOS_UPDATE_LOG", "/var/log/rgos-update.log")
TTY = os.environ.get("RGOS_UPDATE_TTY", "/dev/tty1")
DEVICE_FILE = os.environ.get("RGOS_DEVICE_FILE", "/etc/rgos-device")
BOOT_MNT = os.environ.get("RGOS_BOOT_MNT", "/boot")


class UpdateError(Exception):
    pass


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
    except OSError:
        pass


def say(msg):
    log(msg)
    try:
        with open(TTY, "w") as t:
            t.write(msg + "\r\n")
    except OSError:
        pass


def sh(args, timeout=30):
    try:
        p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout, universal_newlines=True)
        return p.returncode, p.stdout
    except (OSError, subprocess.SubprocessError) as e:
        return 127, "%s" % e



def _device():
    try:
        return open(DEVICE_FILE).read().strip()
    except OSError:
        return ""


def _natural(s):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", s)]


def partitions():
    try:
        names = os.listdir("/sys/class/block")
    except OSError:
        return []
    cand = [n for n in names if re.match(r"^(mmcblk\d+(p\d+)?|sd[a-z]+\d*)$", n)]
    def child(w, o):
        return re.fullmatch(re.escape(w) + (r"p\d+" if w.startswith("mmcblk") else r"\d+"), o) is not None
    whole = [n for n in cand if re.match(r"^(mmcblk\d+|sd[a-z]+)$", n)]
    skip = {w for w in whole if any(child(w, o) for o in cand)}
    return ["/dev/" + n for n in sorted(cand, key=_natural) if n not in skip]


def mounted_at(dev):
    try:
        with open("/proc/mounts") as f:
            for line in f:
                p = line.split()
                if len(p) >= 2 and p[0] == dev:
                    return p[1]
    except OSError:
        pass
    return None


def ensure_fs():
    try:
        have = open("/proc/filesystems").read()
    except OSError:
        have = ""
    for fs in ("exfat", "vfat"):
        if not re.search(r"\b%s\b" % fs, have):
            sh(["modprobe", fs])


def mount_dev(dev, mnt, ro):
    os.makedirs(mnt, exist_ok=True)
    for fs in ("exfat", "vfat", "ext4"):
        rc, _ = sh(["mount", "-t", fs, "-o", "noatime," + ("ro" if ro else "rw"), dev, mnt])
        if rc == 0:
            return fs
    return None


def is_boot(d):
    return (os.path.isfile(os.path.join(d, "SYSTEM")) and os.path.isfile(os.path.join(d, "rgos-initrd.cpio"))
            and (os.path.isfile(os.path.join(d, "extlinux", "extlinux.conf")) or os.path.isfile(os.path.join(d, "extlinux.conf"))))


def find_boot(parts):
    if os.path.ismount(BOOT_MNT) and is_boot(BOOT_MNT):
        return BOOT_MNT, None
    probe = os.path.join(RUN, "probe")
    for dev in parts:
        if mounted_at(dev) or not mount_dev(dev, probe, True):
            continue
        ok = is_boot(probe)
        sh(["umount", probe])
        if ok and mount_dev(dev, BOOT_MNT, False):
            return BOOT_MNT, dev
    return None


def _subdir(base, name):
    try:
        return next((os.path.join(base, e) for e in os.listdir(base) if e.lower() == name and os.path.isdir(os.path.join(base, e))), None)
    except OSError:
        return None


DEVICES = ("rg-rotate", "rg34xxsp", "rg35xxh", "rg35xxsp", "miniloong")


def pick_tar(tars, device):
    """Newest tar in the update folder that is not named for a different device.

    build.sh names them rgos-update-<device>-<id>.tar, so a folder that holds the tars of several consoles
    used to hand this device whichever name sorted last: a wrong-device tar that was rejected and renamed
    .failed while the right one waited for another boot. Tars with no device in the name are still allowed.
    """
    others = [d for d in DEVICES if d != device]
    mine = [t for t in tars if not any("-%s-" % d in t.lower() for d in others)]
    return sorted(mine, key=_natural)[-1] if mine else None


def find_update(parts):
    for dev in parts:
        mp = mounted_at(dev)
        ours = mp is None
        if ours:
            mp = os.path.join(RUN, "src-" + os.path.basename(dev))
            if not mount_dev(dev, mp, True):
                continue
        found = None
        roms = _subdir(mp, "roms")
        for base in (mp, roms):
            d = _subdir(base, UPD_DIR) if base else None
            if not d:
                continue
            try:
                tars = sorted(f for f in os.listdir(d) if TAR_RE.search(f) and not f.startswith(".") and os.path.isfile(os.path.join(d, f)))
            except OSError:
                tars = []
            tar = pick_tar(tars, _device())
            if tar:
                found = (dev, mp, ours, d, os.path.join(d, tar))
                break
        if found:
            return found
        if ours:
            sh(["umount", mp])
    return None



def sane(name, head):
    if name == "SYSTEM":
        return head[:4] == b"hsqs"
    if name == "KERNEL":
        return head[56:60] == b"ARM\x64" or head[:2] in (b"\x1f\x8b", b"MZ")
    if name.endswith(".dtb") or name == "dtb.img":
        return head[:4] == b"\xd0\x0d\xfe\xed"
    if name == "rgos-initrd.cpio":
        return head[:6] in (b"070701", b"070702") or head[:2] == b"\x1f\x8b"
    return b"\0" not in head


def read_tar(path):
    try:
        tf = tarfile.open(path, "r:*")
        members = {}
        for m in tf:
            if m.isdir():
                continue
            if not m.isreg():
                raise UpdateError("unsupported entry in tar: %s" % m.name)
            members[posixpath.normpath(m.name)] = m
    except (tarfile.TarError, OSError, EOFError) as e:
        raise UpdateError("cannot read tar: %s" % e)
    allowed = {"manifest.json"} | {"boot/" + f for f in BOOT_FILES}
    for n in members:
        if n not in allowed:
            raise UpdateError("unexpected file in tar: %s" % n)
    if "manifest.json" not in members:
        raise UpdateError("manifest.json missing - not an RG OS update")
    try:
        man = json.loads(tf.extractfile(members["manifest.json"]).read(1 << 20).decode())
        assert isinstance(man, dict)
    except (ValueError, AssertionError, UnicodeDecodeError):
        raise UpdateError("manifest.json is not valid")
    if man.get("format") != FORMAT:
        raise UpdateError("unsupported update format %r" % man.get("format"))
    if not ID_RE.match(str(man.get("id", ""))):
        raise UpdateError("manifest has no valid id")
    device = _device()
    if man.get("device") != device:
        raise UpdateError("built for %r, this device is %r" % (man.get("device"), device))
    payload = {f: members["boot/" + f] for f in BOOT_FILES if "boot/" + f in members}
    if not payload:
        raise UpdateError("tar contains no boot files")
    files = man.get("files")
    if not isinstance(files, dict) or set(files) != set(payload):
        raise UpdateError("manifest file list does not match the tar contents")
    for f in payload:
        if not re.fullmatch(r"[0-9a-f]{64}", str(files[f])):
            raise UpdateError("bad checksum entry for %s" % f)
    return tf, man, payload


class Progress:
    """Overall percentage across every file being staged, redrawn in place on the console."""

    def __init__(self, total):
        self.total, self.done, self.last = max(1, total), 0, -1
        self.out = None
        try:
            self.out = open(TTY, "w")
        except OSError:
            if sys.stdout.isatty():
                self.out = sys.stdout

    def _show(self, pct):
        self.last = pct
        if self.out:
            try:
                self.out.write("\r\033[K  Updating... %d%%" % pct)
                self.out.flush()
            except OSError:
                self.out = None

    def add(self, n):
        self.done += n
        pct = min(99, self.done * 100 // self.total)      # 100% only once everything is written and synced
        if pct != self.last:
            self._show(pct)

    def finish(self, ok=True):
        if ok:
            self._show(100)
        if self.out:
            try:
                self.out.write("\r\n")
                self.out.flush()
                if self.out is not sys.stdout:
                    self.out.close()
            except OSError:
                pass
            self.out = None


def _stage(tf, member, name, expect, dest, prog=None):
    h, head = hashlib.sha256(), b""
    src = tf.extractfile(member)
    with open(dest, "wb") as out:
        while True:
            b = src.read(1 << 20)
            if not b:
                break
            if not head:
                head = b[:64]
            h.update(b)
            out.write(b)
            if prog:
                prog.add(len(b))
        out.flush()
        os.fsync(out.fileno())
    if h.hexdigest() != expect:
        raise UpdateError("checksum mismatch for %s (damaged tar? copy it again)" % name)
    if not sane(name, head):
        raise UpdateError("%s does not look like a valid file of that type" % name)


def _verify(tf, member, name, expect):
    """Stream one tar member through SHA-256 without writing anything."""
    h, head = hashlib.sha256(), b""
    src = tf.extractfile(member)
    while True:
        b = src.read(1 << 20)
        if not b:
            break
        if not head:
            head = b[:64]
        h.update(b)
    if h.hexdigest() != expect:
        raise UpdateError("checksum mismatch for %s (damaged tar? copy it again)" % name)
    if not sane(name, head):
        raise UpdateError("%s does not look like a valid file of that type" % name)


def _cleanup(bootdir):
    for name in BOOT_FILES:
        for ext in (".new",):
            try:
                os.remove(os.path.join(bootdir, name + ext))
            except OSError:
                pass


def ensure_writable(bootdir):
    probe = os.path.join(bootdir, ".rgos-w")
    for attempt in (0, 1):
        try:
            with open(probe, "w") as f:
                f.write("x")
            os.remove(probe)
            return
        except OSError as e:
            if attempt == 0:
                sh(["mount", "-o", "remount,rw", bootdir])
                continue
            raise UpdateError("boot partition is not writable (%s). Put the card in a PC and let it repair the FAT partition "
                              "(Windows: right-click > Properties > Tools > Check), then try again" % e)


def _old_size(bootdir, name):
    try:
        return os.path.getsize(os.path.join(bootdir, name))
    except OSError:
        return 0


def plan_inplace(order, new_sizes, old_sizes, free_bytes):
    """Which files must replace their old copy in place (old file deleted right before the new one is written).

    Files are staged in `order`. Free space at each step is what is free now, minus the new files already written, plus the old
    copies already deleted. A file that does not fit first goes in place itself; if that is still not enough, files staged
    earlier are switched to in-place too (their old copies are freed first) until it fits. Raises UpdateError, saying how much
    is missing, when even replacing everything in place is not enough."""
    cur = free_bytes - MARGIN
    inplace, normal = set(), []
    for name in order:
        size = new_sizes[name]
        if size > cur:
            if old_sizes.get(name):
                inplace.add(name)
                cur += old_sizes[name]
            if size > cur:
                for n in sorted(normal, key=lambda x: old_sizes.get(x, 0), reverse=True):
                    if size <= cur:
                        break
                    if old_sizes.get(n):
                        normal.remove(n)
                        inplace.add(n)
                        cur += old_sizes[n]
            if size > cur:
                mib = lambda v: (max(v, 0) + (1 << 20) - 1) >> 20
                raise UpdateError("not enough free space on the boot partition: %s needs %d MiB, but only %d MiB can be made free "
                                  "even by replacing the old files in place (%d MiB short). The boot partition was sized for the "
                                  "image that is installed and this update is bigger: reflash a newer image (its boot partition "
                                  "leaves room for updates), or delete big files from the FAT partition's root "
                                  "(rgos-bootinfo.txt, *.prev, *.new, old logs, ROMs in roms/) and try again"
                                  % (name, mib(size), mib(cur), mib(size - cur)))
        elif name not in inplace:
            normal.append(name)
        cur -= size
    return inplace


def apply_tar(tar, bootdir):
    tf, man, payload = read_tar(tar)
    uid = str(man["id"])
    try:
        cur = open(os.path.join(bootdir, ID_FILE)).read().strip()
    except OSError:
        cur = ""
    if cur == uid:
        return "same", uid
    ensure_writable(bootdir)
    _cleanup(bootdir)
    free = lambda: (lambda st: st.f_bavail * st.f_frsize)(os.statvfs(bootdir))
    # smallest first: kernel / dtb / initrd are staged normally, the big SYSTEM image goes last
    order = sorted(payload, key=lambda n: (payload[n].size, n))
    need = sum(m.size for m in payload.values()) + MARGIN
    inplace = set()
    if free() < need:
        for name in BOOT_FILES:                      # old .prev copies are only a rollback convenience: drop them first
            try:
                os.remove(os.path.join(bootdir, name + ".prev"))
            except OSError:
                pass
    if free() < need:
        # Not enough room to keep old + new side by side. Work out which files have to replace the old copy in place.
        # Everything is verified from the tar first, so the old files are never deleted for a damaged update.
        inplace = plan_inplace(order, {n: payload[n].size for n in payload},
                               {n: _old_size(bootdir, n) for n in payload}, free())
        say("  boot partition is small: replacing %s in place" % (", ".join(sorted(inplace)) or "nothing"))
        say("  verifying update before touching the old files...")
        vtf, _, vpayload = read_tar(tar)
        try:
            for name in order:
                _verify(vtf, vpayload[name], name, man["files"][name])
        except (OSError, tarfile.TarError, EOFError) as e:
            raise UpdateError("cannot verify tar: %s" % e)
        finally:
            vtf.close()
    prog = Progress(sum(m.size for m in payload.values()))
    ok = False
    try:
        for name in order:
            m = payload[name]
            log("  staging %s (%d KiB)" % (name, m.size >> 10))
            if name in inplace:
                for ext in ("", ".prev"):            # no room for two copies: the old one goes now, the new one is verified already
                    try:
                        os.remove(os.path.join(bootdir, name + ext))
                    except OSError:
                        pass
                log("  %s: old copy removed (in-place update)" % name)
            _stage(tf, m, name, man["files"][name], os.path.join(bootdir, name + ".new"), prog)
        ok = True
    except (UpdateError, OSError, tarfile.TarError, EOFError) as e:
        _cleanup(bootdir)
        if inplace:
            raise UpdateError("%s. The old %s was already removed to make room, so the system will not boot: "
                              "copy the files from the update tar (boot/ folder) onto the FAT boot partition from a PC"
                              % (e, ", ".join(sorted(inplace))))
        raise UpdateError(str(e))
    finally:
        prog.finish(ok)
        tf.close()
    say("  installing")
    idp = os.path.join(bootdir, ID_FILE)
    try:
        old_id = open(idp).read()
    except OSError:
        old_id = None
    done = []
    try:
        for name in order:
            dst = os.path.join(bootdir, name)
            had = os.path.isfile(dst)
            if had:
                try:
                    os.remove(dst + ".prev")
                except OSError:
                    pass
                os.replace(dst, dst + ".prev")
            done.append((dst, had))
            os.replace(dst + ".new", dst)
        with open(idp + ".new", "w") as f:
            f.write(uid + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(idp + ".new", idp)
        os.sync()
    except OSError as e:
        say("  install failed: %s; restoring previous boot files" % e)
        errors = []
        for dst, had in reversed(done):
            try:
                if had:
                    os.replace(dst + ".prev", dst)
                elif os.path.exists(dst):
                    os.remove(dst)
            except OSError as re_:
                errors.append("%s: %s" % (dst, re_))
        try:
            if old_id is None:
                os.remove(idp)
            else:
                with open(idp, "w") as f:
                    f.write(old_id)
        except OSError:
            pass
        _cleanup(bootdir)
        os.sync()
        raise UpdateError("installation failed; " + ("rollback incomplete, check the *.prev files" if errors else "previous boot files restored"))
    os.sync()
    # The update is installed (new files in place, build id written, everything synced): only now are the old copies deleted.
    # Until this point they were the rollback; a failure above restores them and never reaches this line.
    for name in order:
        try:
            os.remove(os.path.join(bootdir, name + ".prev"))
        except OSError:
            pass
    os.sync()
    return "installed", uid



def _mark(tar, suffix):
    try:
        os.replace(tar, tar + suffix)
    except OSError as e:
        log("could not rename %s: %s" % (tar, e))


def cmd_apply(tar, bootdir):
    try:
        status, uid = apply_tar(tar, bootdir)
    except UpdateError as e:
        print("FAILED: %s" % e)
        return 1
    print("%s: %s" % (status, uid))
    return 10 if status == "installed" else 0


def cmd_boot():
    parts = []
    for _ in range(20):
        parts = partitions()
        if parts:
            break
        time.sleep(0.5)
    if not parts:
        return 0
    ensure_fs()
    boot = find_boot(parts)
    src = find_update(parts)
    if not src:
        return 0
    dev, mp, ours, upd, tar = src
    base = os.path.basename(tar)
    try:
        with open(TTY, "w") as t:
            t.write("\033[2J\033[H")
    except OSError:
        pass
    say("RG OS update: %s" % base)
    result, rc, suffix = "", 0, ".failed"
    if not boot:
        result = "no RG OS boot partition found"
    else:
        try:
            status, uid = apply_tar(tar, boot[0])
            suffix = ".applied"
            if status == "same":
                result = "build %s is already installed - skipped" % uid
            else:
                result, rc = "build %s installed" % uid, 10
        except UpdateError as e:
            result = "FAILED: %s" % e
        except OSError as e:
            result = "FAILED: %s" % e
    say("RG OS update: " + result)
    sh(["mount", "-o", "remount,rw", mp])
    _mark(tar, suffix)
    try:
        with open(os.path.join(upd, "rgos-update.log"), "a") as f:
            f.write("%s %s: %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), base, result))
    except OSError:
        pass
    os.sync()
    if ours:
        sh(["umount", mp])
    say("Restarting..." if rc == 10 else "Continuing with the installed system.")
    time.sleep(2 if rc == 10 else 6)
    return rc


def main(argv):
    if len(argv) >= 2 and argv[1] == "boot":
        return cmd_boot()
    if len(argv) == 4 and argv[1] == "apply":
        return cmd_apply(argv[2], argv[3])
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
