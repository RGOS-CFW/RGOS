#!/usr/bin/env python3
"""RG OS system overlay: shows the volume bar on top of whatever is on screen.

rgos-volume writes "<percent> <stamp>" to /run/rgos/volume on every volume key press. This daemon watches that file
and, for a moment after each change, paints a small bar straight into the framebuffer. It is a separate process, so it
works the same in the launcher, in RetroArch and in native ports.

How it behaves around a program that is also drawing to the framebuffer:
  * the pixels under the bar are saved before it is drawn;
  * while it is visible it is checked 30 times a second: if the program repainted the area, the new pixels are saved
    and the bar is drawn again on top;
  * when it times out the saved pixels are put back, unless the program already painted over the bar itself.
While any game runs (/run/rgos/ingame exists), RetroArch included, /dev/fb0 is hidden behind the game's DRM/KMS output, so
the bar goes on a hardware overlay plane (drmplane.py): the display controller composites it above the game's own plane, so it
is the top layer whatever the game draws. If no plane can be had, RetroArch gets its own on-screen message instead (SHOW_MSG)
and a native port gets the old framebuffer bar. RGOS_OVERLAY_DRM=0 skips the plane (RetroArch then always uses SHOW_MSG).
The bar's colours follow the launcher theme (the launcher writes /run/rgos/theme).

Environment: RGOS_OVERLAY_DRM (1; 0 = never use an overlay plane), RGOS_FB_DEV (/dev/fb0), RGOS_FB_ROTATE (same meaning as for the launcher), RGOS_RUN (/run/rgos),
RGOS_VOLUME_FILE, RGOS_THEME_FILE, RGOS_OVERLAY_HOLD (seconds the bar stays, default 1.5).
"""
import fcntl, json, os, socket, struct, sys, time

RUN_DIR = os.environ.get("RGOS_RUN", "/run/rgos")
VOLUME_FILE = os.environ.get("RGOS_VOLUME_FILE", os.path.join(RUN_DIR, "volume"))
THEME_FILE = os.environ.get("RGOS_THEME_FILE", os.path.join(RUN_DIR, "theme"))
FB_DEV = os.environ.get("RGOS_FB_DEV", "/dev/fb0")
FONT_PATH = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
HOLD = float(os.environ.get("RGOS_OVERLAY_HOLD", "1.5") or 1.5)
BOOT_QUIET = 15.0
FAST, SLOW = 1 / 30.0, 0.1
FBIOGET_VSCREENINFO, FBIOGET_FSCREENINFO = 0x4600, 0x4602
DEFAULT_THEME = {"BG": (13, 15, 26), "PANEL": (24, 28, 46), "ACCENT": (255, 99, 71), "TEXT": (232, 235, 245)}
GAME_FLAG = os.environ.get("RGOS_GAME_FLAG", os.path.join(RUN_DIR, "ingame"))
RA_ADDR = ("127.0.0.1", int(os.environ.get("RGOS_RA_PORT", "55355") or 55355))
USE_DRM = os.environ.get("RGOS_OVERLAY_DRM", "1") != "0"
BAR_W, BAR_H, BASE_W = 260, 44, 720


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def parse_volume(text):
    try:
        v, stamp = text.split()[:2]
        return max(0, min(100, int(v))), stamp
    except (ValueError, AttributeError):
        return None


def read_volume():
    try:
        with open(VOLUME_FILE) as f:
            return parse_volume(f.read())
    except OSError:
        return None


def parse_theme(text):
    """'r,g,b r,g,b r,g,b r,g,b' (BG PANEL ACCENT TEXT) -> dict; anything malformed gives the default theme."""
    try:
        cols = [tuple(max(0, min(255, int(c))) for c in part.split(",")) for part in text.split()]
        if len(cols) == 4 and all(len(c) == 3 for c in cols):
            return dict(zip(("BG", "PANEL", "ACCENT", "TEXT"), cols))
    except (ValueError, AttributeError):
        pass
    return dict(DEFAULT_THEME)


def read_theme():
    try:
        with open(THEME_FILE) as f:
            return parse_theme(f.read())
    except OSError:
        return dict(DEFAULT_THEME)


def retroarch_running(path=GAME_FLAG):
    """True while RetroArch is the foreground program. It renders through DRM/KMS, so anything painted into /dev/fb0
    is never shown over it: the volume bar has to be drawn by RetroArch itself (network command SHOW_MSG)."""
    try:
        with open(path) as f:
            info = json.load(f)
    except (OSError, ValueError):
        return False
    return isinstance(info, dict) and info.get("kind") == "retroarch"


def game_running(path=GAME_FLAG):
    """True while any game (RetroArch or a native port) runs: /dev/fb0 is hidden behind its DRM/KMS output."""
    try:
        with open(path) as f:
            return isinstance(json.load(f), dict)
    except (OSError, ValueError):
        return False


def volume_text(pct, width=20):
    pct = max(0, min(100, int(pct)))
    n = (pct * width + 50) // 100
    return "Volume %3d%%  [%s%s]" % (pct, "#" * n, "-" * (width - n))


def ra_message(text, addr=RA_ADDR):
    """Show text on top of the running RetroArch picture (its on-screen message). False if it could not be sent."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.sendto(("SHOW_MSG " + text).encode("ascii", "replace"), addr)
        return True
    except OSError as e:
        log("SHOW_MSG failed: %r" % e)
        return False
    finally:
        s.close()


def volume_target(game, retroarch, drm_bad, use_drm=None):
    """Where the volume bar is drawn: "drm" (hardware overlay plane, above any DRM/KMS game), "ra" (RetroArch's own on-screen
    message, when no plane can be had) or "fb" (the framebuffer, which only shows when no game is running)."""
    use_drm = USE_DRM if use_drm is None else use_drm
    if game and use_drm and not drm_bad:
        return "drm"
    return "ra" if retroarch else "fb"


def logical_size(xres, yres, rotate):
    return (yres, xres) if rotate in (90, 270) else (xres, yres)


def bar_geometry(lw, lh):
    """Bar size and position (x, y, w, h) in the upright (logical) screen, scaled to the screen width."""
    s = max(0.6, min(1.6, lw / float(BASE_W)))
    w, h = int(BAR_W * s), int(BAR_H * s)
    return (lw - w) // 2, lh - h - int(36 * s), w, h


def to_fb_rect(rect, lw, lh, rotate):
    """Map a rectangle of the upright screen onto the framebuffer, whose content is the screen rotated clockwise by rotate."""
    x, y, w, h = rect
    if rotate == 90:
        return lh - y - h, x, h, w
    if rotate == 180:
        return lw - x - w, lh - y - h, w, h
    if rotate == 270:
        return y, lw - x - w, h, w
    return x, y, w, h


class Overlay:
    def __init__(self, screen, clock=time.monotonic):
        self.screen, self.clock = screen, clock
        self.pct, self.until = 0, 0.0
        self.saved = self.drawn = self.key = None

    def show(self, pct):
        self.pct, self.until = pct, self.clock() + HOLD
        self._paint()

    def _paint(self):
        scr = self.screen
        key = scr.position()
        cur = scr.read()
        if self.key != key or self.saved is None:
            self.saved = cur
        elif self.drawn is not None and cur != self.drawn:
            self.saved = cur
        self.key = key
        self.drawn = scr.compose(self.saved, self.pct)
        scr.write(self.drawn)

    def tick(self):
        """Call regularly; returns True while the bar is on screen."""
        if self.until <= 0:
            return False
        if self.clock() >= self.until:
            self.hide()
            return False
        scr = self.screen
        if scr.position() != self.key or scr.read() != self.drawn:
            self._paint()
        return True

    def hide(self):
        if self.drawn is not None and self.saved is not None:
            try:
                if self.screen.position() == self.key and self.screen.read() == self.drawn:
                    self.screen.write(self.saved)
            except OSError as e:
                log("restore failed: %r" % e)
        self.saved = self.drawn = self.key = None
        self.until = 0.0


class FbScreen:
    def __init__(self, dev=FB_DEV):
        import pygame
        self.pg = pygame
        pygame.display.init()
        pygame.font.init()
        self.fd = os.open(dev, os.O_RDWR)
        self.rotate = int(os.environ.get("RGOS_FB_ROTATE", "0") or 0) % 360
        if self.rotate not in (0, 90, 180, 270):
            self.rotate = 0
        raw = self._var()
        self.xres, self.yres, self.xvirt, self.yvirt, self.xoff, self.yoff, self.bpp = struct.unpack_from("<7I", raw, 0)
        if self.bpp not in (16, 24, 32):
            raise RuntimeError("unsupported framebuffer depth %d" % self.bpp)
        ro, rl, _, go, gl, _, bo, bl, _, to, tl, _ = struct.unpack_from("<12I", raw, 32)
        f = bytearray(80)
        fcntl.ioctl(self.fd, FBIOGET_FSCREENINFO, f)
        self.line = struct.unpack_from("<I", f, 48)[0]
        mask = lambda o, l: ((1 << l) - 1) << o
        self.masks = (mask(ro, rl), mask(go, gl), mask(bo, bl), mask(to, tl) if tl else 0)
        self.bpx = self.bpp // 8
        self.lw, self.lh = logical_size(self.xres, self.yres, self.rotate)
        self.scale = max(0.6, min(1.6, self.lw / float(BASE_W)))
        self.rect = to_fb_rect(bar_geometry(self.lw, self.lh), self.lw, self.lh, self.rotate)
        self.theme = dict(DEFAULT_THEME)
        self.font = self._font(int(14 * self.scale))

    def _font(self, size):
        pg = self.pg
        try:
            return pg.font.Font(FONT_PATH, size) if os.path.exists(FONT_PATH) else pg.font.Font(None, int(size * 1.3))
        except Exception:
            return pg.font.Font(None, int(size * 1.3))

    def _var(self):
        v = bytearray(160)
        fcntl.ioctl(self.fd, FBIOGET_VSCREENINFO, v)
        return v

    def position(self):
        """Which part of video memory is on screen (a game that flips pages moves it)."""
        a, b = struct.unpack_from("<2I", self._var(), 16)
        return a, b

    def _offset(self, y):
        xo, yo = self.position()
        return (yo + self.rect[1] + y) * self.line + (xo + self.rect[0]) * self.bpx

    def read(self):
        x, y, w, h = self.rect
        return [os.pread(self.fd, w * self.bpx, self._offset(r)) for r in range(h)]

    def write(self, rows):
        for r, data in enumerate(rows):
            off, n = self._offset(r), 0
            while n < len(data):
                n += os.pwrite(self.fd, data[n:], off + n)

    def _surface_from(self, rows, w, h):
        pg = self.pg
        sf = pg.Surface((w, h), 0, self.bpp, self.masks)
        pitch, buf = sf.get_pitch(), sf.get_buffer()
        for r, data in enumerate(rows):
            buf.write(data, r * pitch)
        del buf
        return sf

    def _rows_of(self, sf, w, h):
        pitch, buf = sf.get_pitch(), sf.get_buffer()
        raw = buf.raw
        del buf
        return [bytes(raw[r * pitch:r * pitch + w * self.bpx]) for r in range(h)]

    def compose(self, saved, pct):
        """The saved pixels with the bar drawn over them, as framebuffer rows."""
        bar = self.bar_surface(pct)
        fw, fh = bar.get_size()
        sf = self._surface_from(saved, fw, fh)
        sf.blit(bar, (0, 0))
        return self._rows_of(sf, fw, fh)

    def bar_surface(self, pct):
        """The volume bar as an alpha surface already turned to the panel's orientation."""
        pg, s = self.pg, self.scale
        self.theme = read_theme()
        c = self.theme
        _, _, w, h = bar_geometry(self.lw, self.lh)
        bar = pg.Surface((w, h), pg.SRCALPHA)
        rad = max(4, int(10 * s))
        pg.draw.rect(bar, c["PANEL"], (0, 0, w, h), border_radius=rad)
        pg.draw.rect(bar, c["ACCENT"], (0, 0, w, h), max(1, int(2 * s)), border_radius=rad)
        lab = self.font.render("VOL", True, c["TEXT"])
        pct_t = self.font.render("%d%%" % pct, True, c["TEXT"])
        ty = (h - lab.get_height()) // 2
        bar.blit(lab, (int(14 * s), ty))
        bx, bw_, bh_ = int(56 * s), int(140 * s), max(4, int(10 * s))
        by = (h - bh_) // 2
        pg.draw.rect(bar, c["BG"], (bx, by, bw_, bh_), border_radius=bh_ // 2)
        if pct:
            pg.draw.rect(bar, c["ACCENT"], (bx, by, max(bh_ + 1, bw_ * pct // 100), bh_), border_radius=bh_ // 2)
        bar.blit(pct_t, (w - pct_t.get_width() - int(12 * s), ty))
        if self.rotate:
            bar = pg.transform.rotate(bar, -self.rotate)
        return bar


class DrmBar:
    """The volume bar on a hardware overlay plane: shown above a DRM/KMS game (native ports) where /dev/fb0 is hidden."""

    def __init__(self, fb, drm_mod):
        self.fb, self.drm_mod, self.drm, self.until = fb, drm_mod, None, 0.0

    def show(self, pct, hold):
        fb, pg = self.fb, self.fb.pg
        if self.drm is None:
            self.drm = self.drm_mod.DrmOverlay()
        bar = fb.bar_surface(pct)
        w, h = bar.get_size()
        sf = pg.Surface((w, h), pg.SRCALPHA, 32)
        sf.blit(bar, (0, 0))
        if self.drm.premultiplied() and hasattr(sf, "premul_alpha"):
            sf = sf.premul_alpha()
        raw = pg.image.tostring(sf, "BGRA")
        self.drm.show(fb.rect, raw)
        self.until = time.monotonic() + hold

    def tick(self):
        if self.drm is not None and self.until and time.monotonic() >= self.until:
            self.hide()
        return self.drm is not None and self.until > 0

    def hide(self):
        if self.drm is not None:
            self.drm.close()
        self.drm, self.until = None, 0.0


def load_drm():
    import importlib
    here = os.path.dirname(os.path.abspath(__file__))
    if here not in sys.path:
        sys.path.insert(0, here)
    return importlib.import_module("drmplane")


def run():
    start = time.monotonic()
    ov, last, drm_bar, drm_bad = None, read_volume(), None, False
    
    seen_stamp, seen_pct = (last[1], last[0]) if last else (None, None)
    log("overlay started (volume %s)" % (seen_pct if last else "unknown"))
    while True:
        if ov is None:
            try:
                ov = Overlay(FbScreen())
                log("framebuffer %dx%d %dbpp rotate %d" % (ov.screen.xres, ov.screen.yres, ov.screen.bpp, ov.screen.rotate))
            except Exception as e:
                log("framebuffer not available: %r" % e)
                time.sleep(3.0)
                continue
        try:
            v = read_volume()
            if v and v[1] != seen_stamp:
                quiet = time.monotonic() - start < BOOT_QUIET and v[0] == seen_pct
                seen_stamp, seen_pct = v[1], v[0]
                if not quiet:
                    where = volume_target(game_running(), retroarch_running(), drm_bad)
                    if where == "drm":
                        try:
                            drm_bar = drm_bar or DrmBar(ov.screen, load_drm())
                            drm_bar.show(v[0], HOLD)
                        except Exception as e:
                            log("overlay plane failed (%r); falling back" % e)
                            drm_bad = True
                            if drm_bar:
                                drm_bar.hide()
                            drm_bar = None
                            where = volume_target(True, retroarch_running(), drm_bad)
                    if where == "ra":
                        ra_message(volume_text(v[0]))
                    elif where == "fb":
                        ov.show(v[0])
            busy = ov.tick()
            if drm_bar is not None:
                busy = drm_bar.tick() or busy
                if not drm_bar.until:
                    drm_bar = None if not game_running() else drm_bar
        except Exception as e:
            log("overlay error: %r" % e)
            try:
                os.close(ov.screen.fd)
            except Exception:
                pass
            ov = None
            time.sleep(1.0)
            continue
        time.sleep(FAST if busy else SLOW)


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
    run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
