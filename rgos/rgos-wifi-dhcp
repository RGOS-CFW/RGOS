#!/bin/sh
[ -n "$interface" ] || exit 0
case "$1" in
  deconfig)
    ip -4 addr flush dev "$interface" 2>/dev/null
    ip link set "$interface" up 2>/dev/null
    ;;
  bound|renew)
    bits="$mask"
    if [ -z "$bits" ] && [ -n "$subnet" ]; then
      bits=0; for o in $(echo "$subnet" | tr . ' '); do
        while [ "$o" -gt 0 ]; do bits=$((bits + (o & 1))); o=$((o >> 1)); done
      done
    fi
    ip -4 addr flush dev "$interface" 2>/dev/null
    ip route flush dev "$interface" 2>/dev/null
    ip addr add "$ip/${bits:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
    for r in $router; do ip route add default via "$r" dev "$interface" metric 10 2>/dev/null; done
    run="${RGOS_RUN:-/run/rgos}"
    mkdir -p "$run"
    : > "$run/resolv.conf"
    for d in $dns; do echo "nameserver $d" >> "$run/resolv.conf"; done
    # a lease without DNS (or none usable) would leave every host lookup failing: use the router, then public resolvers
    if [ -z "$dns" ]; then
      for r in $router; do echo "nameserver $r" >> "$run/resolv.conf"; done
      echo "nameserver 1.1.1.1" >> "$run/resolv.conf"
      echo "nameserver 9.9.9.9" >> "$run/resolv.conf"
    fi
    [ -n "$domain" ] && echo "search $domain" >> "$run/resolv.conf"
    ;;
esac
exit 0
