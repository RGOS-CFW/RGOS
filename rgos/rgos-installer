def colors():
    return {"BG": BG, "PANEL": PANEL, "SEL_BG": SEL_BG, "ACCENT": ACCENT, "TEXT": TEXT, "DIM": DIM}


def wrap(font, text, width):
    lines, cur = [], ""
    for word in text.split():
        trial = (cur + " " + word).strip()
        if font.size(trial)[0] <= width or not cur:
            cur = trial
        else:
            lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    return lines


def header(pg, canvas, size, fonts, device="", step=None):
    """Top bar shared by every screen: the RG OS mark, a dim "Installer" tag, the device name as a pill, and a hairline."""
    W, H = size
    f_title, f_row, f_small = fonts
    m = 28
    pg.draw.rect(canvas, ACCENT, (m, 22, 8, 30), border_radius=3)
    canvas.blit(f_title.render("RG OS", True, TEXT), (m + 20, 18))
    canvas.blit(f_small.render("INSTALLER", True, ACCENT), (m + 20 + f_title.size("RG OS")[0] + 14, 36))
    dev = installer.DEVICE_NAMES.get(device, device)
    if dev:
        pw, ph = f_small.size(dev)[0] + 26, f_small.size(dev)[1] + 10
        pg.draw.rect(canvas, PANEL, (W - m - pw, 24, pw, ph), border_radius=ph // 2)
        canvas.blit(f_small.render(dev, True, DIM), (W - m - pw + 13, 29))
    pg.draw.line(canvas, EDGE, (m, 68), (W - m, 68), 1)
    if step:
        dots = 3
        for i in range(dots):
            pg.draw.circle(canvas, ACCENT if i < step else EDGE, (W // 2 - 20 + i * 20, 62), 3)


def key_hint(pg, canvas, font, x, y, key, label, col=DIM):
    """One footer hint: a small rounded key cap followed by what it does. Returns the x where the next hint may start."""
    kw, kh = max(font.size(key)[1] + 4, font.size(key)[0] + 14), font.size(key)[1] + 4
    pg.draw.rect(canvas, col, (x, y, kw, kh), border_radius=kh // 2)
    canvas.blit(font.render(key, True, BG), (x + (kw - font.size(key)[0]) // 2, y + 2))
    canvas.blit(font.render(label, True, col), (x + kw + 8, y + 2))
    return x + kw + 8 + font.size(label)[0] + 24


def hint_bar(pg, canvas, size, font, hints, y=None, x0=0):
    """Centred footer made of key_hint()s, e.g. [("A", "Confirm"), ("B", "Back")]. `size` is the width and height of the area to
    centre in (x0 is its left edge); y overrides the default spot near the bottom."""
    W, H = size
    widths = []
    for key, label in hints:
        widths.append(max(font.size(key)[1] + 4, font.size(key)[0] + 14) + 8 + font.size(label)[0])
    total = sum(widths) + 24 * (len(hints) - 1)
    x, y = x0 + (W - total) // 2, H - 38 if y is None else y
    for key, label in hints:
        x = key_hint(pg, canvas, font, x, y, key, label)


def draw(pg, canvas, size, fonts, snap, t, countdown=None):
    W, H = size
    f_title, f_row, f_small = fonts
    canvas.fill(BG)
    m = 28
    canvas.blit(f_title.render("RG OS", True, ACCENT), (m, 20))
    canvas.blit(f_small.render("Installer", True, DIM), (m + f_title.size("RG OS")[0] + 12, 34))
    dev = installer.DEVICE_NAMES.get(snap["device"], snap["device"])
    if dev:
        s = f_small.render(dev, True, DIM)
        canvas.blit(s, (W - m - s.get_width(), 34))
    pg.draw.line(canvas, PANEL, (m, 64), (W - m, 64), 2)

    y, row_h = 78, max(24, min(34, (H - 250) // max(1, len(snap["steps"]))))
    for s in snap["steps"]:
        cx, cy = m + 10, y + row_h // 2 - 2
        st = s["status"]
        if st in ("done", "skip"):
            pg.draw.circle(canvas, OK, (cx, cy), 8)
            col = TEXT
        elif st == "run":
            pulse = 5 + int(3 * (0.5 + 0.5 * math.sin(t * 6)))
            pg.draw.circle(canvas, ACCENT, (cx, cy), pulse)
            col = ACCENT
        elif st == "fail":
            pg.draw.circle(canvas, BAD, (cx, cy), 8)
            col = BAD
        else:
            pg.draw.circle(canvas, DIM, (cx, cy), 8, 2)
            col = DIM
        canvas.blit(f_row.render(s["name"], True, col), (m + 30, y))
        if st == "skip":
            lab = f_small.render("already there", True, DIM)
            canvas.blit(lab, (W - m - lab.get_width(), y + 3))
        y += row_h

    bar_h = 22
    bar_y = H - 74
    box = (m, bar_y, W - 2 * m, bar_h)
    pg.draw.rect(canvas, PANEL, box, border_radius=6)
    frac = max(0.0, min(1.0, snap["fraction"]))
    fail = bool(snap["error"])
    if snap["indeterminate"] and not snap["finished"]:
        seg = int(box[2] * 0.22)
        pos = int((box[2] - seg) * (0.5 + 0.5 * math.sin(t * 3)))
        pg.draw.rect(canvas, ACCENT, (box[0] + pos, bar_y, seg, bar_h), border_radius=6)
    elif frac > 0:
        pg.draw.rect(canvas, BAD if fail else ACCENT, (box[0], bar_y, max(6, int(box[2] * frac)), bar_h), border_radius=6)
    pct = f_small.render("%d%%" % int(frac * 100), True, BG if frac > 0.5 and not snap["indeterminate"] else TEXT)
    canvas.blit(pct, (box[0] + box[2] // 2 - pct.get_width() // 2, bar_y + 2))

    if fail:
        lines = wrap(f_small, snap["error"], W - 2 * m)[:3]
        yy = bar_y - 8 - 20 * (len(lines) + 1)
        for ln in lines:
            canvas.blit(f_small.render(ln, True, BAD), (m, yy))
            yy += 20
        canvas.blit(f_small.render("A  Try again        B  Start RG OS anyway", True, TEXT), (m, yy + 2))
        foot = "Details: rgos-install-log.txt on the boot partition"
    elif snap["finished"] and snap["ok"]:
        msg = "All done. Restarting%s" % ("" if countdown is None else " in %d..." % max(0, int(countdown + 0.99)))
        canvas.blit(f_row.render(msg, True, OK), (m, bar_y - 34))
        foot = "RG OS is installed"
    else:
        if snap["detail"]:
            canvas.blit(f_small.render(snap["detail"][:90], True, TEXT), (m, bar_y - 26))
        foot = "Do not turn off the console"
    canvas.blit(f_small.render(foot, True, DIM), (m, bar_y + bar_h + 8))


CON_BG = (0, 0, 0)
CON_COL = {"info": (40, 225, 80), "ok": (150, 255, 170), "warn": (235, 190, 40), "err": BAD, "dim": (0, 125, 45),
           "hex": (0, 165, 60)}
CONSOLE_SECONDS = (10.0, 15.0)    # the fake exploit takes at least this long (picked at random per run)
CONSOLE_KEEP = 300                # lines remembered; only the last screenful is ever drawn
FINAL_GAP = 0.35                  # seconds between the closing lines


def console_script(rng, device_name=""):
    """The scripted part of the fake exploit as [(text, kind, weight)]: weight is how long the line takes relative to the others."""
    out = []
    kva = lambda: "0xffffff80%08x" % rng.getrandbits(32)
    uva = lambda: "0x0000007f%08x" % rng.getrandbits(32)

    def add(text, kind="info", w=None):
        out.append((text, kind, w if w is not None else rng.uniform(0.5, 1.8)))

    def dump(n):
        for _ in range(n):
            row = " ".join("%02x" % rng.getrandbits(8) for _ in range(16))
            add("%s: %s" % (kva(), row), "hex", 0.12)

    add("rgos-pwn 1.3.37 - kernel privilege escalation toolkit", "ok", 0.8)
    add("[*] target : %s / aarch64 / linux" % (device_name or "handheld"), "info", 0.6)
    add("[*] checking environment ...", "info", 0.6)
    add("[+] ptrace_scope=0, unprivileged userns available", "ok")
    add("[*] reading /proc/kallsyms", "info")
    add("[+] commit_creds          @ %s" % kva(), "ok", 0.3)
    add("[+] prepare_kernel_cred   @ %s" % kva(), "ok", 0.3)
    add("[+] init_task             @ %s" % kva(), "ok", 0.3)
    add("[+] selinux_state         @ %s" % kva(), "ok", 0.3)
    add("[*] leaking KASLR slide ...")
    for _ in range(4):
        add("[-] probe %s ... miss" % kva(), "dim", 0.25)
    add("[+] KASLR slide = 0x%08x" % (rng.getrandbits(12) << 20), "ok")
    dump(4)
    add("[*] spraying kmalloc-512 (4096 objects)")
    add("[##########----------] 50%", "warn", 0.9)
    add("[####################] 100%", "warn", 0.9)
    add("[+] heap groomed, 4096/4096 slots owned", "ok")
    add("[*] opening /dev/ptmx, racing tty_ldisc teardown")
    add("[!] race lost, retrying (attempt 1/8)", "warn", 0.7)
    add("[!] race lost, retrying (attempt 2/8)", "warn", 0.7)
    add("[+] race won on attempt 3, use-after-free triggered", "ok", 1.2)
    dump(5)
    add("[*] corrupting freelist pointer @ %s" % kva())
    add("[*] reclaiming freed object with controlled data")
    add("[+] arbitrary kernel write primitive acquired", "ok", 1.2)
    add("[*] walking task list to find pid 1")
    add("[+] task_struct(init) @ %s" % kva(), "ok", 0.4)
    add("[*] overwriting cred: uid=gid=euid=egid=0")
    add("[+] uid=0(root) gid=0(root) groups=0(root)", "ok", 1.0)
    add("[*] clearing capability bounding set restrictions")
    add("[*] selinux_state.enforcing: 1 -> 0")
    add("[+] SELinux permissive", "ok", 0.5)
    add("[*] remounting / read-write")
    add("[+] / is rw", "ok", 0.4)
    dump(3)
    add("[*] staging payload at %s" % uva())
    add("[*] writing partition table")
    add("[*] formatting ROMS partition")
    add("[+] stage 1 complete", "ok", 0.9)
    add("[*] hooking sys_call_table[%d]" % rng.randint(60, 290))
    add("[*] unpacking libretro cores")
    dump(4)
    add("[*] injecting PortMaster")
    add("[+] stage 2 loaded @ %s" % kva(), "ok", 0.8)
    add("[*] verifying SHA-256 of every module")
    add("[+] all checksums match", "ok", 0.6)
    return out


def console_filler(rng):
    """One more line of noise, for when the real install takes longer than the scripted part."""
    kva = "0xffffff80%08x" % rng.getrandbits(32)
    kind = rng.randint(0, 6)
    if kind <= 2:
        return "%s: %s" % (kva, " ".join("%02x" % rng.getrandbits(8) for _ in range(16))), "hex"
    if kind == 3:
        return "[*] flushing icache %s - 0xffffff80%08x" % (kva, rng.getrandbits(32)), "info"
    if kind == 4:
        return "[+] gadget @ %s: ldp x29, x30, [sp], #0x10 ; ret" % kva, "ok"
    if kind == 5:
        return "[*] reclaiming slab page %s" % kva, "info"
    return "[~] syncing stage buffers (%d dirty pages)" % rng.randint(8, 900), "warn"


class ConsoleFeed:
    """The text on the fake exploit console: what has been printed so far, driven by the clock and by the real install.

    The scripted lines are spread over the first 90% of `duration` seconds (10 to 15, random). After that it keeps printing noise
    until the real install has finished AND `duration` is over, then prints the closing lines. It never ends before the real
    work does, and it freezes when the install fails (the caller shows the error under it).
    """

    def __init__(self, now, device_name="", rng=None, duration=None):
        self.rng = rng or random.Random()
        self.duration = duration if duration else self.rng.uniform(*CONSOLE_SECONDS)
        self.t0 = now
        script = console_script(self.rng, device_name)
        total = sum(w for _, _, w in script)
        acc, self.body, self.times = 0.0, [], []
        for text, kind, w in script:
            acc += w
            self.body.append((text, kind))
            self.times.append(self.t0 + 0.9 * self.duration * acc / total)
        self.final = [("[+] stage 2 complete, payload installed", "ok"), ("[*] syncing disks ...", "info"),
                      ("[+] root access: GRANTED", "ok"), ("[+] done", "ok")]
        self.lines, self.i, self.j = [], 0, 0
        self.final_at = None
        self.next_filler = 0.0

    @property
    def complete(self):
        return self.final_at is not None and self.j >= len(self.final)

    def update(self, now, installed, failed):
        if failed:
            return
        while self.i < len(self.body) and self.times[self.i] <= now:
            self.lines.append(self.body[self.i])
            self.i += 1
        if self.final_at is None:
            if self.i < len(self.body):
                pass
            elif installed and now - self.t0 >= self.duration:
                self.final_at = now
            elif now >= self.next_filler:
                self.lines.append(console_filler(self.rng))
                self.next_filler = now + self.rng.uniform(0.07, 0.2)
        if self.final_at is not None:
            while self.j < len(self.final) and now - self.final_at >= self.j * FINAL_GAP:
                self.lines.append(self.final[self.j])
                self.j += 1
        del self.lines[:-CONSOLE_KEEP]


def fit(font, text, width):
    """Cut `text` so it is no wider than `width` pixels."""
    while len(text) > 1 and font.size(text)[0] > width:
        text = text[:-1]
    return text


def draw_console(pg, canvas, size, font, feed, snap, t, countdown=None, mo=None):
    """Green-on-black scrolling console: a title strip, the last screenful of feed lines, the error / restart notice, a prompt,
    and a slim bar at the bottom that shows the real install progress (glides to each new value when there is a Motion)."""
    W, H = size
    pad = 14
    lh = font.size("Ag")[1] + 3
    top, foot_h = 30, lh + 14
    canvas.fill(CON_BG)
    pg.draw.rect(canvas, (6, 28, 12), (0, 0, W, top))
    pg.draw.line(canvas, (0, 80, 30), (0, top), (W, top), 1)
    for i, col in enumerate(((235, 190, 40), (40, 225, 80), (0, 125, 45))):
        pg.draw.circle(canvas, col, (pad + 5 + i * 18, top // 2), 4)
    canvas.blit(font.render("rgos-pwn - root@rgos", True, CON_COL["dim"]), (pad + 66, top // 2 - lh // 2 + 1))
    rows = max(3, (H - top - foot_h - pad) // lh)
    view = list(feed.lines)
    fail = bool(snap["error"])
    if fail:
        view.append(("", "info"))
        view += [(ln, "err") for ln in wrap(font, "[!] FAILED: " + snap["error"], W - 2 * pad)[:4]]
        view += [("", "info"), ("A  Try again        B  Start RG OS anyway", "ok")]
    elif countdown is not None:
        view.append(("[*] restarting in %d ..." % max(0, int(countdown + 0.99)), "ok"))
    prompt = not fail and countdown is None
    view = view[-(rows - 1 if prompt else rows):]
    y = top + pad
    for text, kind in view:
        if text:
            canvas.blit(font.render(fit(font, text, W - 2 * pad), True, CON_COL[kind]), (pad, y))
        y += lh
    if prompt:
        label = "root@rgos:/# "
        canvas.blit(font.render(label, True, CON_COL["ok"]), (pad, y))
        if int(t * 2) % 2 == 0:
            pg.draw.rect(canvas, CON_COL["ok"], (pad + font.size(label)[0], y + 2, max(6, font.size("M")[0]), lh - 4))
    # the real install progress, as a thin bar above the footer text
    frac = max(0.0, min(1.0, snap.get("fraction", 0.0) or 0.0))
    if mo is not None:
        frac = max(0.0, min(1.0, mo.val("progress", frac, 8.0)))
    bar_y = H - foot_h + 2
    pg.draw.rect(canvas, (0, 45, 18), (pad, bar_y, W - 2 * pad, 4), border_radius=2)
    if fail:
        pg.draw.rect(canvas, BAD, (pad, bar_y, max(4, int((W - 2 * pad) * frac)), 4), border_radius=2)
    elif frac > 0:
        pg.draw.rect(canvas, CON_COL["info"], (pad, bar_y, max(4, int((W - 2 * pad) * frac)), 4), border_radius=2)
    foot = "Details: rgos-install-log.txt on the boot partition" if fail else "Do not turn off the console"
    canvas.blit(font.render(foot, True, CON_COL["dim"]), (pad, bar_y + 9))
    if not fail:
        pct = "%d%%" % int(frac * 100)
        canvas.blit(font.render(pct, True, CON_COL["dim"]), (W - pad - font.size(pct)[0], bar_y + 9))


def menu_input(sel, typ, code, val):
    """One input event on the welcome screen -> (new selection, chosen action or None).

    Up/left and down/right (D-pad keys or the hat axes) move between the two buttons, A or START confirms.
    """
    step = 0
    if typ == EV_KEY and val == 1:
        if code in (KEY_UP, KEY_LEFT):
            step = -1
        elif code in (KEY_DOWN, KEY_RIGHT):
            step = 1
        elif code in (BTN_A, BTN_START):
            return sel, CHOICES[sel]
    elif typ == EV_ABS and code in (ABS_HAT0X, ABS_HAT0Y) and val in (-1, 1):
        step = val
    return (sel + step) % len(CHOICES), None


def format_input(sel, typ, code, val):
    """One input event on the ROMS format popup -> (new selection, action).

    The action is None, "back" (B) or one of installer.ROMS_FORMATS (A or START on that row). Up/left and down/right
    (D-pad keys or the hat axes) move through the list and wrap around.
    """
    step = 0
    if typ == EV_KEY and val == 1:
        if code in (KEY_UP, KEY_LEFT):
            step = -1
        elif code in (KEY_DOWN, KEY_RIGHT):
            step = 1
        elif code in (BTN_A, BTN_START):
            return sel, FORMAT_CHOICES[sel]
        elif code == BTN_B:
            return sel, "back"
    elif typ == EV_ABS and code in (ABS_HAT0X, ABS_HAT0Y) and val in (-1, 1):
        step = val
    return (sel + step) % len(FORMAT_CHOICES), None


def draw_format_popup(pg, canvas, size, fonts, sel, device="", mo=None):
    """The "which format for the ROMS partition?" popup: the welcome screen dimmed behind a panel with one row per file system.

    With a Motion (`mo`) the panel rises in each time it opens and the rows are the launcher's buttons: the selected one eases
    to its colour, lifts its border in and fills its radio dot; the highlight glides between rows instead of jumping.
    """
    W, H = size
    f_title, f_row, f_small = fonts
    mo = mo or uimotion.Motion(pg, size, colors(), settled=True)
    draw_welcome(pg, canvas, size, fonts, 0, device, mo)
    shade = pg.Surface((W, H), pg.SRCALPHA)
    shade.fill((0, 0, 0, 200))
    canvas.blit(shade, (0, 0))

    rise = int((1.0 - uimotion.out_cubic(mo.since("format", 0.4) / 0.30)) * 16)
    row_h, pad = 60, 20
    pw = min(W - 56, 600)
    ph = pad + 28 + 4 + 20 + 12 + row_h * len(FORMAT_CHOICES) + 4 + 20 + 12 + 1 + 12 + 22 + pad - 6
    px, py = (W - pw) // 2, max(8, (H - ph) // 2) + rise
    pg.draw.rect(canvas, EDGE, (px - 1, py - 1, pw + 2, ph + 2), border_radius=19)
    pg.draw.rect(canvas, BG, (px, py, pw, ph), border_radius=18)
    canvas.blit(f_row.render("Storage format", True, TEXT), (px + pad, py + pad))
    canvas.blit(f_small.render("How should the ROMS partition be formatted?", True, DIM), (px + pad, py + pad + 28))

    y = py + pad + 28 + 4 + 20 + 12
    for i, key in enumerate(FORMAT_CHOICES):
        on = i == sel
        box = (px + pad, y, pw - 2 * pad, row_h - 8)
        hl, _lift = mo.button(canvas, box, SEL_BG if on else PANEL, 12, 3, on, ("fmt", i))
        fg, sub = uimotion.mix(DIM, TEXT, hl), uimotion.mix(DIM, (200, 190, 160), hl)
        cx, cy = box[0] + 26, box[1] + (row_h - 8) // 2
        pg.draw.circle(canvas, uimotion.mix(DIM, ACCENT, hl), (cx, cy), 9, 2)       # radio dot, fills as the row is selected
        if hl > 0:
            pg.draw.circle(canvas, ACCENT, (cx, cy), max(1, int(5 * hl)))
        canvas.blit(f_row.render(installer.FORMAT_LABELS[key], True, fg), (box[0] + 50, box[1] + 6))
        hint = installer.FORMAT_HINTS[key].replace("Recommended. ", "")
        canvas.blit(f_small.render(hint, True, sub), (box[0] + 50, box[1] + 30))
        if key == installer.DEFAULT_ROMS_FORMAT:
            tag = "RECOMMENDED"
            tw, th = f_small.size(tag)[0] + 18, f_small.size(tag)[1] + 4
            tx, ty = box[0] + box[2] - tw - 14, box[1] + 8
            pg.draw.rect(canvas, uimotion.mix(PANEL_HI, BG, hl), (tx, ty, tw, th), border_radius=th // 2)
            canvas.blit(f_small.render(tag, True, uimotion.mix(DIM, ACCENT, hl)), (tx + 9, ty + 2))
        y += row_h
    canvas.blit(f_small.render("An existing ROMS partition keeps its format.", True, DIM), (px + pad, y + 2))
    pg.draw.line(canvas, EDGE, (px + pad, y + 28), (px + pw - pad, y + 28), 1)
    hint_bar(pg, canvas, (pw, H), f_small, [("D-pad", "Choose"), ("A", "Confirm"), ("B", "Back")], y=y + 40, x0=px)


def button_boxes(size, y_top):
    """The two square buttons as (x, y, side, side), side by side and centred, below the intro text (which ends at y_top)."""
    W, H = size
    m, gap = 28, 28
    side = max(80, min(200, (W - 2 * m - gap) // 2, H - 56 - (y_top + 10)))
    top = min(max(y_top + 10, (H - side) // 2 - 10), H - 56 - side)
    left = (W - (2 * side + gap)) // 2
    return [(left + i * (side + gap), top, side, side) for i in range(len(CHOICES))]


def draw_icon(pg, canvas, kind, cx, cy, r, col):
    """Install: an arrow dropping into a tray. Power off: the usual ring with a bar at the top. Plain shapes, no image files."""
    w = max(4, r // 5)
    if kind == "install":
        pg.draw.line(canvas, col, (cx, cy - r), (cx, cy - int(r * 0.2)), w)
        pg.draw.polygon(canvas, col, [(cx - int(r * 0.6), cy - int(r * 0.25)), (cx + int(r * 0.6), cy - int(r * 0.25)),
                                      (cx, cy + int(r * 0.45))])
        pg.draw.lines(canvas, col, False, [(cx - r, cy + int(r * 0.15)), (cx - r, cy + int(r * 0.95)),
                                           (cx + r, cy + int(r * 0.95)), (cx + r, cy + int(r * 0.15))], w)
    else:
        rect = (cx - r, cy - r + int(r * 0.15), 2 * r, 2 * r)
        gap = 0.65  # radians left open at the top
        pg.draw.arc(canvas, col, rect, math.pi / 2 + gap, math.pi / 2 + 2 * math.pi - gap, w)
        pg.draw.line(canvas, col, (cx, cy - r), (cx, cy - int(r * 0.1)), w)


def draw_welcome(pg, canvas, size, fonts, sel, device="", mo=None):
    """The first screen: what is about to happen, then the Install and Power off tiles, moving like the launcher's home screen.

    The tiles pop in one after another (glide up, fade in), one focus ring springs to the selected tile and breathes there, the
    selected tile lifts, eases to its colour and gets a shine sweep now and then, embers drift up behind, and the caption
    under the tiles fades up after every move. Without a Motion (`mo`) it is drawn finished, once.
    """
    W, H = size
    f_title, f_row, f_small = fonts
    mo = mo or uimotion.Motion(pg, size, colors(), settled=True)
    canvas.fill(BG)
    mo.draw_embers(canvas)
    m = 28
    header(pg, canvas, size, fonts, device)

    y = 90
    canvas.blit(f_title.render("Ready to install", True, TEXT), (m, y))
    y += 44
    for ln in wrap(f_small, "Sets up this SD card and restarts into RG OS.", W - 2 * m):
        canvas.blit(f_small.render(ln, True, DIM), (m, y))
        y += 22
    pg.draw.circle(canvas, OK, (m + 6, y + 10), 5)
    canvas.blit(f_small.render("Games on an existing ROMS partition are never deleted.", True, DIM), (m + 20, y + 1))
    y += 28

    boxes = button_boxes((W, H), y)
    el = mo.since("welcome", reset_ring=True)
    sub_p = uimotion.out_cubic(mo.changed("welcome-sel", sel) / 0.30)
    bx0, by0, side = boxes[sel][0], boxes[sel][1], boxes[sel][2]
    speed, rem = mo.ring_step(bx0, by0 - uimotion.LIFT_PX)

    def paint(i):
        key, box = CHOICES[i], boxes[i]

        def go(surf, bx, by):
            on = i == sel
            hl, lift = mo.button(surf, (bx, by, side, side), SEL_BG if on else PANEL, 20, 6, on, ("tile", i), False)
            by -= lift
            draw_icon(pg, surf, key, bx + side // 2, by + int(side * 0.40), int(side * 0.24), uimotion.mix(DIM, ACCENT, hl))
            label = f_row.render(CHOICE_LABELS[key], True, uimotion.mix(DIM, TEXT, hl))
            surf.blit(label, (bx + (side - label.get_width()) // 2, by + side - 42))
            if on and surf is canvas:
                mo.shine(surf, (bx, by, side, side), 20, hl)
        return go

    for i, box in enumerate(boxes):
        mo.pop(canvas, box, uimotion.out_cubic((el - 0.05 - 0.06 * i) / 0.42), paint(i))
    mo.draw_ring(canvas, side, side, uimotion.out_cubic((el - 0.30) / 0.30) if el < 0.7 else 1.0, speed, rem, 20)

    cap = f_small.render(CHOICE_SUBS[CHOICES[sel]], True, DIM)
    if sub_p < 1.0:
        cap.set_alpha(int(255 * sub_p))
    canvas.blit(cap, ((W - cap.get_width()) // 2, by0 + side + 16 + int((1.0 - sub_p) * 6)))
    hint_bar(pg, canvas, size, f_small, [("D-pad", "Choose"), ("A", "Confirm")])


def show_headless(inst):
    """No usable screen: run without one, report on the console, never block the boot."""
    inst.run()
    snap = inst.snapshot()
    try:
        with open("/dev/tty1", "w") as t:
            t.write("RG OS installer: %s\r\n" % ("done" if snap["ok"] else "FAILED: " + snap["error"]))
    except OSError:
        pass
    return installer.EXIT_REBOOT if snap["ok"] else 0


def main():
    boost = uiboost.UiBoost()      # CPU / GPU clocks up while the person uses the menu; always put back before leaving
    try:
        return run(boost)
    finally:
        boost.restore()


def run(boost):
    if installer.pending() is None:
        return 0
    inst = installer.Installer()
    try:
        import pygame
        import evpad
        import fbout
        os.environ["SDL_VIDEODRIVER"] = "dummy"
        pygame.init()
        pygame.display.init()
        W, H = installer.CANVAS.get(installer.device_id(), installer.CANVAS["rg-rotate"])
        pygame.display.set_mode((W, H))
        fb = fbout.FbOut()
        fbout.set_graphics(True)
        canvas = pygame.Surface((W, H))
        path = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
        mk = (lambda s: pygame.font.Font(path, s)) if os.path.exists(path) else (lambda s: pygame.font.Font(None, int(s * 1.3)))
        fonts = (mk(34), mk(19), mk(15))
        mono_path = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
        mono = pygame.font.Font(mono_path, 14) if os.path.exists(mono_path) else pygame.font.Font(None, 20)
        pads = evpad.EvPads()
        mo = uimotion.Motion(pygame, (W, H), colors())
    except Exception as e:  # pygame / framebuffer problem: install anyway
        installer.log("installer screen unavailable (%s); running without it" % e)
        return show_headless(inst)

    last_act = [time.monotonic()]

    def pace(settles=True):
        """How long to wait for input before the next frame: full rate while something moves or was just pressed, the
        launcher's idle rate when left alone on a menu (the console keeps scrolling, so it never goes below 30 fps)."""
        quiet = time.monotonic() - last_act[0]
        if mo.moving or quiet < 0.5:
            return FRAME_FAST
        return FRAME_IDLE if settles and quiet > 3.0 else FRAME_NORMAL

    def events():
        """Pad events since the last frame; any of them counts as the person being there (clocks stay up, frame rate up)."""
        ev = pads.read()
        if ev:
            last_act[0] = time.monotonic()
            boost.poke()
        return ev

    def start(i):
        th = threading.Thread(target=i.run, daemon=True)
        th.start()
        return th

    def frame(draw_fn, key, fade, *args):
        """One frame: advance the clock, draw, crossfade if the screen changed, put it on the display."""
        mo.tick()
        if mo.moving:
            boost.poke()
        boost.tick()
        try:
            draw_fn(*args)
            mo.transition(canvas, key, fade)
            fb.present(canvas)
        except Exception as e:
            installer.log("draw failed: %s" % e)

    def show(draw_fn, *args):
        frame(lambda: draw_fn(pygame, canvas, (W, H), fonts, *args, mo=mo), draw_fn.__name__, uimotion.FADE_S)

    def show_console(feed, snap, t, countdown):
        frame(lambda: draw_console(pygame, canvas, (W, H), mono, feed, snap, t, countdown, mo=mo), "console", CONSOLE_FADE)

    # welcome screen: nothing on the card is touched until Install is chosen and a ROMS format has been picked
    sel = 0
    fmt_sel = FORMAT_CHOICES.index(installer.DEFAULT_ROMS_FORMAT)
    fmt = None
    while fmt is None:
        show(draw_welcome, sel, installer.device_id())
        pads.wait(pace())
        choice = None
        for typ, code, val in events():
            sel, picked = menu_input(sel, typ, code, val)
            choice = choice or picked
        if choice == "poweroff":
            installer.log("person chose Power off on the welcome screen; nothing was changed")
            return installer.EXIT_POWEROFF
        if choice == "install":
            installer.log("person chose Install")
            # popup: which file system for the ROMS partition? B returns to the welcome screen
            while True:
                show(draw_format_popup, fmt_sel, installer.device_id())
                pads.wait(pace())
                action = None
                for typ, code, val in events():
                    fmt_sel, picked = format_input(fmt_sel, typ, code, val)
                    action = action or picked
                if action == "back":
                    installer.log("person backed out of the ROMS format menu")
                    break
                if action in FORMAT_CHOICES:
                    fmt = action
                    installer.log("person chose %s for the ROMS partition" % installer.FORMAT_LABELS[fmt])
                    break

    inst = installer.Installer(fmt=fmt)
    start(inst)
    device_name = installer.DEVICE_NAMES.get(installer.device_id(), "")
    feed = ConsoleFeed(time.time(), device_name)
    done_at = None
    while True:
        t = time.time()
        snap = inst.snapshot()
        feed.update(t, bool(snap["finished"] and snap["ok"]), bool(snap["error"]))
        if feed.complete and done_at is None:
            done_at = t
        countdown = None if done_at is None else REBOOT_DELAY - (t - done_at)
        show_console(feed, snap, t, countdown)
        if countdown is not None and countdown <= 0:
            return installer.EXIT_REBOOT
        pads.wait(pace(False))
        for typ, code, val in events():
            if typ != 1 or val != 1 or not (snap["finished"] and snap["error"]):
                continue
            if code == BTN_A:
                inst = installer.Installer(fmt=fmt)
                start(inst)
                feed = ConsoleFeed(time.time(), device_name)
            elif code == BTN_B:
                installer.log("person chose to boot RG OS without finishing the install")
                return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as e:
        installer.log("rgos-installer crashed: %s" % e)
        sys.exit(0)
