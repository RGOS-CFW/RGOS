def _ioc(d, t, nr, size):
    return (d << 30) | (size << 16) | (ord(t) << 8) | nr
_IOW = lambda t, nr, size: _ioc(1, t, nr, size)
_IOR = lambda t, nr, size: _ioc(2, t, nr, size)
_IOWR = lambda t, nr, size: _ioc(3, t, nr, size)

EVIOCGRAB = _IOW("E", 0x90, 4)
EVIOCGNAME = _IOR("E", 0x06, 128)
EVIOCGBIT_ABS = _IOR("E", 0x20 + 3, 8)
EVIOCGABS = lambda a: _IOR("E", 0x40 + a, 24)
EVIOCGBIT_KEY = _IOR("E", 0x20 + EV_KEY, 96)
UI_DEV_CREATE, UI_DEV_DESTROY = _ioc(0, "U", 1, 0), _ioc(0, "U", 2, 0)
UI_DEV_SETUP = _IOW("U", 3, 92)
UI_SET_EVBIT, UI_SET_KEYBIT = _IOW("U", 100, 4), _IOW("U", 101, 4)
UI_SET_FFBIT = _IOW("U", 107, 4)
EV_FF, FF_RUMBLE = 0x15, 0x50
UI_SET_ABSBIT = _IOW("U", 103, 4)
UI_ABS_SETUP = _IOW("U", 4, 28)
ANALOG_AXES = (0x00, 0x01, 0x03, 0x04)
LEFT_STICK_AXES = (0x00, 0x01)               # always present, so DPAD to joystick can drive them on any device
ABS_X, ABS_Y = 0x00, 0x01
ASTICK = 32767


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def find_raw_event():
    for p in sorted(glob.glob("/sys/class/input/event*")):
        try:
            with open(p + "/device/name") as f:
                if f.read().strip() == RAW_NAME:
                    return "/dev/input/" + os.path.basename(p)
        except OSError:
            continue
    return None


def key_codes(fd):
    buf = bytearray(96)
    fcntl.ioctl(fd, EVIOCGBIT_KEY, buf)
    return [i for i in range(96 * 8) if buf[i >> 3] >> (i & 7) & 1]


def make_uinput(codes, ff=False, axes=()):
    fd = None
    for p in ("/dev/uinput", "/dev/input/uinput"):
        try:
            fd = os.open(p, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
            break
        except OSError:
            continue
    if fd is None:
        raise OSError(errno.ENODEV, "no /dev/uinput (kernel without INPUT_UINPUT?)")
    try:
        fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
        for c in codes:
            fcntl.ioctl(fd, UI_SET_KEYBIT, c)
        if axes:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_ABS)
            for a in axes:
                fcntl.ioctl(fd, UI_SET_ABSBIT, a)
                fcntl.ioctl(fd, UI_ABS_SETUP, struct.pack("<H2x6i", a, 0, -ASTICK, ASTICK, 0, 0, 0))
        if ff:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_FF)
            fcntl.ioctl(fd, UI_SET_FFBIT, FF_RUMBLE)
        fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack("<HHHH80sI", 0x19, 0x484B, 0x14DF, 0x100, HUB_NAME.encode(), 16 if ff else 0))
        fcntl.ioctl(fd, UI_DEV_CREATE)
    except OSError:
        os.close(fd)
        raise
    return fd


def udev_refresh():
    try:
        subprocess.run(["udevadm", "control", "--reload"], timeout=10)
        subprocess.run(["udevadm", "trigger", "--action=change", "--subsystem-match=input"], timeout=10)
        subprocess.run(["udevadm", "settle", "--timeout=5"], timeout=10)
    except Exception as e:
        log("udevadm failed:", e)


HIDDEN_NODES = {}


def _save_hidden():
    try:
        if HIDDEN_NODES:
            with open(HIDDEN, "w") as f:
                json.dump([[p, a, b] for p, (a, b) in sorted(HIDDEN_NODES.items())], f)
        elif os.path.exists(HIDDEN):
            os.unlink(HIDDEN)
    except OSError:
        pass


def hide_raw_node(path, sysfs="/sys/class/input"):
    """Take a grabbed raw pad out of /dev/input so SDL ports never see it.

    The hub grabs the raw pad, so it never reports anything to anyone else. The udev rule written by
    write_rules() is meant to hide it from SDL, but this image runs no udevd, so SDL ports saw the dead raw
    pad as controller 0 and the working "RG OS Gamepad" as controller 1: ports that read only the first
    controller had no input. The hub keeps its already-open fd, so unlinking the node is safe. It is put
    back by restore_hidden() when the hub exits, and at the next start if the hub was killed.
    """
    try:
        with open(os.path.join(sysfs, os.path.basename(path), "dev")) as f:
            major, minor = (int(v) for v in f.read().strip().split(":"))
        os.unlink(path)
    except (OSError, ValueError) as e:
        log("cannot hide %s from ports: %s" % (path, e))
        return
    HIDDEN_NODES[path] = (major, minor)
    _save_hidden()
    log("hid %s from SDL ports (the hub owns it)" % path)


def restore_hidden():
    try:
        with open(HIDDEN) as f:
            for p, a, b in json.load(f):
                HIDDEN_NODES.setdefault(p, (a, b))
    except (OSError, ValueError, TypeError):
        pass
    for path, (major, minor) in list(HIDDEN_NODES.items()):
        try:
            if not os.path.exists(path):
                os.mknod(path, 0o666 | stat.S_IFCHR, os.makedev(major, minor))
                os.chmod(path, 0o666)
        except OSError as e:
            log("cannot restore %s: %s" % (path, e))
            continue
        del HIDDEN_NODES[path]
    _save_hidden()


def write_status(text):
    try:
        os.makedirs(os.path.dirname(STATUS), exist_ok=True)
        with open(STATUS + ".tmp", "w") as f:
            f.write(text + "\n")
        os.replace(STATUS + ".tmp", STATUS)
    except OSError:
