def load_input_conf(conf=CONF, devfile="/etc/rgos-device", etc="/etc/rgos"):
    out = {}
    try:
        with open(conf) as f:
            out = json.load(f)
        if not isinstance(out, dict):
            out = {}
    except Exception:
        out = {}
    try:
        with open(devfile) as f:
            dev = f.read().strip()
        with open("%s/input-%s.json" % (etc, dev)) as f:
            extra = json.load(f)
        if isinstance(extra, dict):
            out.update(extra)
    except Exception:
        pass
    return out


def load_keymap(iconf):
    km = {}
    extra = iconf.get("keymap")
    for k, v in (extra.items() if isinstance(extra, dict) else ()):
        try:
            km[(None, 1, int(str(k), 0), 0)] = int(str(v), 0)
        except (ValueError, OverflowError):
            pass
    try:
        with open(BTNMAP) as f:
            raw = json.load(f).get("keys")
        items = list(raw.items()) if isinstance(raw, dict) else []
    except Exception:
        return km
    for k, v in items:
        try:
            name, _, rest = str(k).rpartition("|")
            t, c, sg = rest.split(":")
            km[(name or None, int(t), int(c), int(sg))] = int(v)
        except (TypeError, ValueError, OverflowError):
            continue
    return km


def load_sticks():
    cal = {}
    try:
        with open(BTNMAP) as f:
            raw = json.load(f).get("sticks") or {}
        items = list(raw.items())
    except Exception:
        return cal
    for k, v in items:
        try:
            code = int(k)
            c, lo, hi = (float(x) for x in v)
        except (TypeError, ValueError):
            continue
        if code in ANALOG_AXES and lo < c < hi and min(c - lo, hi - c) >= 4:
            cal[code] = (c, lo, hi)
    return cal


class Translator:
    def __init__(self, keymap=None, legacy=False, auto_map=True):
        self.keymap, self.legacy = keymap or {}, legacy
        self.auto_map = bool(auto_map)
        self.astate = {}
        self.prof = {}
        self.swap = {}
        self.analog = False
        self.stick_cal = {}

    def learn(self, name, keys):
        notes, kmap = [], {}
        if self.auto_map and not self.legacy:
            known = {c for c in keys if (name, 1, c, 0) in self.keymap or (None, 1, c, 0) in self.keymap
                     or c in CANON_KEYS or c in AUTO_KEY_ALIASES or c in EXTRA_KEYS}
            pad_keys = sorted(c for c in keys if c in GAMEPAD_KEY_RANGE)
            if pad_keys and not (known & set(pad_keys)):
                for c, canon in zip(pad_keys, ORDERED_FILL):
                    kmap[c] = canon
                notes.append("buttons: unknown codes, assigned in order %s" % ", ".join(
                    "0x%x->0x%x" % (c, kmap[c]) for c in pad_keys[:len(ORDERED_FILL)]))
            elif known:
                notes.append("buttons: %d recognised" % len(known))
            if set(pad_keys) & set(CANON_KEYS):
                kmap.update({c: None for c in keys if c in AUTO_KEY_ALIASES and c < 0x100 and c not in (103, 105, 106, 108)})
        self.prof[name] = {"keys": kmap}
        return notes

    def key(self, name, code, value):
        t = self.keymap.get((name, 1, code, 0)) or self.keymap.get((None, 1, code, 0))
        pk = self.prof.get(name, {}).get("keys", {})
        if t is None and code in pk:
            if pk[code] is None:
                return []
            t = pk[code]
        if t is None and self.auto_map:
            t = AUTO_KEY_ALIASES.get(code)
        if t is None and (self.legacy or code in CANON_KEYS or code in EXTRA_KEYS):
            t = code
        if t is None:
            return []
        return [(EV_KEY, self.swap.get(t, t), value)]

    def abs(self, name, code, value, rng):
        out = []
        lo, hi = rng
        if hi <= lo:
            lo, hi = -AMAX, AMAX
        mid, half = (lo + hi) / 2.0, max((hi - lo) / 2.0, 1.0)
        for sign in (-1, 1):
            canon = self.keymap.get((name, 3, code, sign)) or self.keymap.get((None, 3, code, sign)) or HAT_KEYS.get((code, sign))
            if canon is None:
                continue
            on = (value - mid) * sign >= 0.6 * half
            k = (name, code, sign)
            if self.astate.get(k, False) != on:
                self.astate[k] = on
                out.append((EV_KEY, canon, 1 if on else 0))
        return out


    def stick(self, code, value, rng):
        if not self.analog or code not in ANALOG_AXES:
            return []
        cal = self.stick_cal.get(code)
        if cal:
            c, clo, chi = cal
            f = (value - c) / (chi - c) if value >= c else (value - c) / (c - clo)
            mag = abs(f)
            f = 0.0 if mag < STICK_DEADZONE else (1 if f > 0 else -1) * (mag - STICK_DEADZONE) / (1.0 - STICK_DEADZONE)
            return [(EV_ABS, code, max(-ASTICK, min(ASTICK, int(round(f * ASTICK)))))]
        lo, hi = rng
        if hi <= lo:
            lo, hi = -AMAX, AMAX
        mid, half = (lo + hi) / 2.0, max((hi - lo) / 2.0, 1.0)
        return [(EV_ABS, code, max(-ASTICK, min(ASTICK, int(round((value - mid) / half * ASTICK)))))]


class Source:
    def __init__(self, path, name):
        self.path, self.name = path, name
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        self.rng = {}
        self.grabbed = False

    def absinfo(self, c):
        try:
            buf = bytearray(24)
            fcntl.ioctl(self.fd, EVIOCGABS(c), buf)
            v, mn, mx = struct.unpack_from("<3i", buf, 0)
        except OSError:
            return None
        return (v, mn, mx) if mx > mn else None

    def absrange(self, c):
        r = self.rng.get(c)
        if r is None:
            try:
                buf = bytearray(24)
                fcntl.ioctl(self.fd, EVIOCGABS(c), buf)
                _, mn, mx = struct.unpack_from("<3i", buf, 0)
                r = (mn, mx)
            except OSError:
                r = (-AMAX, AMAX)
            self.rng[c] = r
        return r

    def grab(self):
        try:
            fcntl.ioctl(self.fd, EVIOCGRAB, 1)
            self.grabbed = True
        except OSError as e:
            log("cannot grab %s (%s): %s (duplicate events possible)" % (self.path, self.name, e))

    def close(self):
        try:
            if self.grabbed:
                fcntl.ioctl(self.fd, EVIOCGRAB, 0)
        except OSError:
            pass
        try:
            os.close(self.fd)
        except OSError:
            pass


def _bits(fd, req, n):
    buf = bytearray(n)
    fcntl.ioctl(fd, req, buf)
    return {i for i in range(n * 8) if buf[i >> 3] >> (i & 7) & 1}


_REJECTED = {}


def _reject(path, name, why):
    if _REJECTED.get(path) != why:
        _REJECTED[path] = why
        log("input skipped %s (%s): %s" % (path, name, why))


def scan_sources(spec, have):
    found = []
    for ev in sorted(glob.glob("/sys/class/input/event*")):
        path = "/dev/input/" + os.path.basename(ev)
        if path in have:
            continue
        try:
            with open(ev + "/device/name") as f:
                name = f.read().strip()
        except OSError:
            continue
        if name == HUB_NAME:
            continue
        if spec == "auto":
            low = name.lower()
            if any(x in low for x in NOT_PADS):
                _reject(path, name, "name is a power/volume/lid/jack/touch device")
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
            except OSError as e:
                _reject(path, name, "cannot open: %s" % e)
                continue
            try:
                keys, axes = _bits(fd, EVIOCGBIT_KEY, 96), _bits(fd, EVIOCGBIT_ABS, 8)
            except OSError as e:
                _reject(path, name, "capability ioctl failed: %s" % e)
                continue
            finally:
                os.close(fd)
            gamepad_keys = keys.intersection(GAMEPAD_KEY_RANGE)
            has_hat = bool(axes.intersection({0x10, 0x11}))
            lname = name.lower()
            gamepad_name = any(word in lname for word in ("gamepad", "joypad", "controller", "gpio-keys", "trimui", "player1"))
            letters = len(keys.intersection(range(16, 50)))
            dpad = keys.intersection({103, 105, 106, 108})
            handheld_actions = keys.intersection(KBD_PAD_KEYS - {103, 105, 106, 108})
            sparse_handheld = len(dpad) >= 2 and bool(handheld_actions) and letters < 20
            kbd_pad = (len(keys.intersection(KBD_PAD_KEYS)) >= 5 or len(dpad) == 4 or sparse_handheld) and letters < 20
            why = None
            if keys.intersection(CANON_KEYS):
                why = "standard pad buttons"
            elif gamepad_keys and (has_hat or gamepad_name):
                why = "pad-range buttons"
            elif kbd_pad:
                why = "keyboard-style handheld buttons"
            if why is None:
                _reject(path, name, "no pad buttons (keys=%d letters=%d hat=%s)" % (len(keys), letters, has_hat))
                continue
            log("input candidate %s (%s): %s; buttons=%d hat=%s" % (path, name, why, len(keys), has_hat))
        elif not any(sub in name for sub in spec):
            continue
        found.append((path, name))
    return found


def learn_source(translator, src):
    try:
        keys = _bits(src.fd, EVIOCGBIT_KEY, 96)
    except OSError:
        keys = set()
    notes = translator.learn(src.name, keys)
    line = "%s (%s): %s" % (src.path, src.name, "; ".join(notes))
    log("auto-map", line)
    try:
        with open(MAP_REPORT, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def write_rules(names):
    try:
        if not names:
            os.unlink(RULES)
            return
        os.makedirs(os.path.dirname(RULES), exist_ok=True)
        with open(RULES, "w") as f:
            for n in sorted(set(names)):
                q = n.replace("\\", "\\\\").replace('"', '\\"')
                f.write('SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="%s", ENV{ID_INPUT_JOYSTICK}="", ENV{ID_INPUT_KEY}="1"\n' % q)
    except OSError:
        pass


class Buzzer:
    """Non-blocking vibration patterns for the feedback buzz (the hub loop must never sleep)."""

    def __init__(self, motor, clock=time.monotonic):
        self.motor, self.clock = motor, clock
        self.steps, self.deadline, self.on = [], 0.0, False

    def play(self, pattern):
        """pattern: seconds, alternating motor on / off, starting with on."""
        if self.motor is None or not pattern:
            return
        self.steps = [(i % 2 == 0, float(s)) for i, s in enumerate(pattern)]
        self._next(self.clock())

    def _next(self, now):
        if not self.steps:
            self._set(False)
            return
        on, dur = self.steps.pop(0)
        self._set(on)
        self.deadline = now + dur

    def _set(self, on):
        if on != self.on:
            self.on = on
            try:
                self.motor.set(on)
            except Exception as e:
                log("vibration failed:", e)

    def tick(self):
        now = self.clock()
        while (self.on or self.steps) and now >= self.deadline:
            self._next(now)
            now = self.clock()

    def next_deadline(self, default=0.25):
        if not (self.on or self.steps):
            return default
        return max(0.0, min(default, self.deadline - self.clock()))

    def close(self):
        self.steps = []
        self._set(False)


class DpadJoy:
    """"DPAD to joystick": while a game runs and the setting is ON, D-pad presses become left-stick movement.

    Works on the translated stream (canonical button codes), so every source, the A/B swap and the button map are
    already applied. The setting is the file DPADJOY (Settings > DPAD to joystick); it is only acted on while a game
    runs (INGAME exists), so the launcher keeps its D-pad.

    Menu+Select, while a game runs, is swallowed (RetroArch would otherwise treat it as its menu hotkey):
      * a short press turns the setting ON and buzzes once;
      * holding it for COMBO_HOLD_S turns it OFF and buzzes twice.
    A real analog stick (when the device has one) still works; the D-pad wins on an axis while it is pushed.
    """

    def __init__(self, feedback=None, clock=time.monotonic):
        self.feedback, self.clock = feedback or (lambda pattern: None), clock
        self.on, self.ingame, self.next_check = False, False, 0.0
        self.pad = {c: False for c in (DPAD_UP, DPAD_DOWN, DPAD_LEFT, DPAD_RIGHT)}
        self.sent = set()                    # D-pad keys currently held down in the virtual pad
        self.phys = {ABS_X: 0, ABS_Y: 0}     # last value of a real stick
        self.axis = {ABS_X: 0, ABS_Y: 0}     # what the virtual pad currently reports
        self.mod = {BTN_SELECT: False, BTN_MODE: False}
        self.held = set()                    # Menu / Select presses that were swallowed (their release is too)
        self.combo = None                    # [pressed at, already fired]
        self.was_active = False

    @property
    def active(self):
        return self.on and self.ingame

    def refresh(self, now):
        if now < self.next_check:
            return
        self.next_check = now + 0.15
        self.on, self.ingame = os.path.exists(DPADJOY), os.path.exists(INGAME)

    def _dpad_value(self, axis):
        d = {ABS_X: int(self.pad[DPAD_RIGHT]) - int(self.pad[DPAD_LEFT]),
             ABS_Y: int(self.pad[DPAD_DOWN]) - int(self.pad[DPAD_UP])}
        if not d[axis]:
            return 0
        return int(round(d[axis] * (DIAGONAL if d[ABS_X] and d[ABS_Y] else 1.0) * ASTICK))

    def _want(self, axis):
        v = self._dpad_value(axis) if self.active else 0
        return v if v else self.phys[axis]

    def _axis_events(self):
        out = []
        for axis in (ABS_X, ABS_Y):
            v = self._want(axis)
            if v != self.axis[axis]:
                self.axis[axis] = v
                out.append((EV_ABS, axis, v))
        return out

    def _set_setting(self, on):
        try:
            if on:
                os.makedirs(os.path.dirname(DPADJOY), exist_ok=True)
                open(DPADJOY, "w").close()
            elif os.path.exists(DPADJOY):
                os.unlink(DPADJOY)
        except OSError as e:
            log("cannot change DPAD to joystick:", e)
            return False
        self.on = on
        self.next_check = 0.0
        log("DPAD to joystick %s (Menu+Select)" % ("ON" if on else "OFF"))
        self.feedback(BUZZ_ON if on else BUZZ_OFF)
        return True

    def _combo_start(self, now):
        self.combo = [now, False]
        try:
            os.makedirs(os.path.dirname(COMBO_FLAG), exist_ok=True)
            open(COMBO_FLAG, "w").close()
        except OSError:
            pass

    def _combo_end(self):
        if self.combo is not None and not self.combo[1]:
            self._set_setting(True)
        self.combo = None

    def _modifier(self, code, value, now):
        """Menu / Select. True when the event is swallowed."""
        if value == 1:
            self.mod[code] = True
            if self.ingame and all(self.mod.values()):
                self.held.add(code)
                self._combo_start(now)
                return True
            return False
        if value == 0:
            self.mod[code] = False
            swallowed = code in self.held
            self.held.discard(code)
            if self.combo is not None:
                self._combo_end()
            return swallowed
        return code in self.held

    def filter(self, events, now):
        """Translated events [(type, code, value)] -> events for the virtual pad."""
        self.refresh(now)
        out = []
        for t, c, v in events:
            if t == EV_KEY and c in self.mod:
                if not self._modifier(c, v, now):
                    out.append((t, c, v))
            elif t == EV_KEY and c in self.pad:
                self.pad[c] = v != 0
                if self.active:
                    out += self._axis_events()
                else:
                    (self.sent.add if v else self.sent.discard)(c)
                    out.append((t, c, v))
            elif t == EV_ABS and c in self.phys:
                self.phys[c] = v
                want = self._want(c)
                self.axis[c] = want
                out.append((t, c, want))
            else:
                out.append((t, c, v))
        return out

    def poll(self, now):
        """Events caused by time or by the setting changing, not by a button."""
        self.refresh(now)
        if self.combo is not None and not self.combo[1] and now - self.combo[0] >= COMBO_HOLD_S:
            self.combo[1] = True
            self._set_setting(False)
        out = []
        if self.active != self.was_active:
            self.was_active = self.active
            if self.active:
                out += [(EV_KEY, c, 0) for c in sorted(self.sent)]
                self.sent.clear()
            else:
                out += [(EV_KEY, c, 1) for c, down in sorted(self.pad.items()) if down]
                self.sent = {c for c, down in self.pad.items() if down}
            out += self._axis_events()
        return out

    def next_deadline(self, now, default=0.25):
        if self.combo is not None and not self.combo[1]:
            return max(0.0, min(default, self.combo[0] + COMBO_HOLD_S - now))
        return default


class KeyProbe:
    def __init__(self):
        self.n, self.next_check, self.on = 0, 0.0, False
        self.next_stick = 0.0
        self.skip_axes = ()

    def feed(self, src, t, c, v):
        if t == EV_ABS and c in self.skip_axes:
            return
        now = time.time()
        if now >= self.next_check:
            self.next_check, self.on = now + 0.1, os.path.exists(KEYS_PROBE)
        if not self.on:
            return
        if t == EV_KEY and v == 1:
            sign = 0
        elif t == EV_ABS:
            lo, hi = src.absrange(c)
            mid, half = (lo + hi) / 2.0, max((hi - lo) / 2.0, 1.0)
            if abs(v - mid) < 0.6 * half:
                return
            sign = 1 if v > mid else -1
        else:
            return
        self.n += 1
        try:
            with open(KEYS_RAW + ".tmp", "w") as f:
                f.write("%d\t%s\t%d\t%d\t%d\n" % (self.n, src.name, t, c, sign))
            os.replace(KEYS_RAW + ".tmp", KEYS_RAW)
        except OSError:
            pass


    def sticks(self, srcs):
        now = time.time()
        if now < self.next_stick:
            return
        self.next_stick = now + 0.05
        if now >= self.next_check:
            self.next_check, self.on = now + 0.1, os.path.exists(KEYS_PROBE)
        if not self.on:
            return
        ax = {}
        for c in ANALOG_AXES:
            for x in srcs.values():
                info = x.absinfo(c)
                if info:
                    ax[str(c)] = list(info)
                    break
        try:
            with open(STICKS_RAW + ".tmp", "w") as f:
                json.dump({"ax": ax}, f)
            os.replace(STICKS_RAW + ".tmp", STICKS_RAW)
        except OSError:
            pass


def run():
    restore_hidden()  # a hub that was killed earlier may have left its raw pad hidden
    iconf = load_input_conf()
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    if iconf.get("enabled") is False:
        write_status("hub: disabled in input.json")
        log("disabled in input.json; leaving the raw input devices alone")
        while not STOP:
            time.sleep(1)  # not 3600: since PEP 475 a signal handler does not cut time.sleep short
        return 0
    os.makedirs("/run/rgos", exist_ok=True)
    spec = iconf.get("sources") or "auto"
    legacy = spec == [RAW_NAME]
    translator = Translator(load_keymap(iconf), legacy=legacy, auto_map=bool(iconf.get("auto_map_buttons", True)))
    translator.analog = bool(iconf.get("analog", False))
    if translator.analog:
        translator.stick_cal = load_sticks()
    if os.path.exists(SWAPAB):
        translator.swap = {0x130: 0x131, 0x131: 0x130}
        log("A/B swap is ON (Settings > Swap A / B buttons)")
    try:
        os.unlink(MAP_REPORT)
    except OSError:
        pass
    log("hub config: sources %s, legacy codes %s, keymap entries %d, auto-map %s, analog sticks %s (%d axes calibrated)" %
        (spec, legacy, len(translator.keymap), translator.auto_map, translator.analog, len(translator.stick_cal)))

    srcs = {}
    while not STOP and not srcs:
        for path, name in scan_sources(spec, srcs):
            try:
                srcs[path] = Source(path, name)
            except OSError as e:
                log("cannot open %s: %s" % (path, e))
        if not srcs:
            write_status("hub: waiting for input devices (%s)" % (spec if spec == "auto" else ",".join(spec)))
            time.sleep(1)
    if STOP:
        return 0
    for x in srcs.values():
        learn_source(translator, x)
    first = next(iter(srcs.values()))
    codes = (sorted(set(key_codes(first.fd)) | set(translator.keymap.values())) if legacy
             else sorted(set(CANON_KEYS + EXTRA_KEYS) | set(translator.keymap.values())))
    log("sources: %s; %d key codes" % (", ".join("%s (%s)" % (x.path, x.name) for x in srcs.values()), len(codes)))

    ff = motor = buzz_motor = None
    hwc = None
    try:
        import hwctl, ffpad
        hwc = hwctl.load_conf()
        if hwc and hwc.get("rumble", {}).get("ff", True):
            m = hwctl.Motor(hwc)
            motor = m if m.available else None
        log("rumble:", motor.describe() if motor else "off")
    except Exception as e:
        log("rumble support unavailable:", e)
    buzz_motor = motor
    if buzz_motor is None:
        try:
            import hwctl
            m = hwctl.Motor(hwc)
            buzz_motor = m if m.available else None
        except Exception as e:
            log("vibration feedback unavailable:", e)
    buzz = Buzzer(buzz_motor)
    djoy = DpadJoy(feedback=buzz.play)
    ufd, tries = None, 0
    while not STOP and ufd is None:
        try:
            ufd = make_uinput(codes, ff=motor is not None, axes=ANALOG_AXES if translator.analog else LEFT_STICK_AXES)
        except OSError as e:
            tries += 1
            if tries == 1:
                subprocess.run(["modprobe", "uinput"], stderr=subprocess.DEVNULL)
            write_status("hub: OFF, uinput: %s" % e)
            if tries == 1 or tries % 30 == 0:
                log("cannot create virtual pad:", e, "-> the menu still reads the raw devices; in-game input needs uinput in the kernel")
            time.sleep(2)
    if STOP:
        return 0
    if motor is not None:
        r_ = hwc.get("rumble", {})
        ff = ffpad.FFHandler(ufd, motor, float(r_.get("threshold", 0.15)), int(r_.get("max_ms", 3000)))
    for x in srcs.values():
        x.grab()
        if x.grabbed:
            hide_raw_node(x.path)
    open(FLAG, "w").close()
    write_rules([x.name for x in srcs.values()])
    udev_refresh()
    log("hub up: '%s'" % HUB_NAME)

    probe_keys = KeyProbe()
    if translator.analog:
        probe_keys.skip_axes = ANALOG_AXES
    last_status, next_scan = 0.0, time.time() + 3.0
    try:
        while not STOP:
            now = time.time()
            if now >= next_scan:
                next_scan = now + 3.0
                if spec == "auto" or not srcs:
                    added = False
                    for path, name in scan_sources(spec, srcs):
                        try:
                            x = Source(path, name)
                        except OSError:
                            continue
                        learn_source(translator, x)
                        x.grab()
                        if x.grabbed:
                            hide_raw_node(path)
                        srcs[path] = x
                        added = True
                        log("source added: %s (%s)" % (path, name))
                    if added:
                        write_rules([x.name for x in srcs.values()])
                        udev_refresh()
            wait = 0.25
            if translator.analog:
                probe_keys.sticks(srcs)
                if probe_keys.on:
                    wait = 0.05
            if ff is not None:
                wait = min(wait, ff.next_deadline())
            wait = min(wait, buzz.next_deadline(), djoy.next_deadline(time.monotonic()))
            r, _, _ = select.select([x.fd for x in srcs.values()] + ([ufd] if ff is not None else []), [], [], wait)
            if ff is not None:
                if ufd in r:
                    ff.service()
                else:
                    ff.tick()
            out = bytearray()
            for x in list(srcs.values()):
                if x.fd not in r:
                    continue
                try:
                    data = os.read(x.fd, EVFMT.size * 64)
                except BlockingIOError:
                    continue
                except OSError as e:
                    log("source gone: %s (%s): %s" % (x.path, x.name, e))
                    x.close()
                    del srcs[x.path]
                    HIDDEN_NODES.pop(x.path, None)
                    _save_hidden()
                    write_rules([y.name for y in srcs.values()])
                    udev_refresh()
                    if legacy and not srcs:
                        return 1
                    continue
                batch = []
                for off in range(0, len(data) - EVFMT.size + 1, EVFMT.size):
                    _, _, t, c, v = EVFMT.unpack_from(data, off)
                    if t in (EV_KEY, EV_ABS):
                        probe_keys.feed(x, t, c, v)
                    if t == EV_KEY:
                        batch += translator.key(x.name, c, v)
                    elif t == EV_ABS:
                        batch += translator.abs(x.name, c, v, x.absrange(c))
                        batch += translator.stick(c, v, x.absrange(c))
                    elif t == EV_SYN:
                        batch.append((EV_SYN, 0, 0))
                batch = djoy.filter(batch, time.monotonic())
                for t, c, v in batch:
                    out += EVFMT.pack(0, 0, t, c, v)
                if batch and batch[-1][0] != EV_SYN:
                    out += EVFMT.pack(0, 0, EV_SYN, 0, 0)
            extra = djoy.poll(time.monotonic())
            buzz.tick()
            if extra:
                for t, c, v in extra:
                    out += EVFMT.pack(0, 0, t, c, v)
                out += EVFMT.pack(0, 0, EV_SYN, 0, 0)
            if out:
                try:
                    os.write(ufd, bytes(out))
                except OSError as e:
                    if e.errno != errno.EAGAIN:
                        log("uinput write failed:", e)
                        return 1
            if time.time() - last_status > 0.5:
                last_status = time.time()
                write_status("hub:ok src:%d" % len(srcs))
        return 0
    finally:
        try:
            buzz.close()
            if ff is not None:
                ff.close()
            for x in srcs.values():
                x.close()
            fcntl.ioctl(ufd, UI_DEV_DESTROY)
        except OSError:
            pass
        restore_hidden()
        for p in (FLAG, STATUS, KEYS_RAW, STICKS_RAW, RULES, MAP_REPORT, COMBO_FLAG):
            try:
                os.unlink(p)
            except OSError:
                pass
        udev_refresh()


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "reset-buttons":
        try:
            os.unlink(BTNMAP)
            print("removed", BTNMAP)
        except OSError:
            print("no button mapping stored")
        return 0
    return run()


if __name__ == "__main__":
    sys.exit(main())
