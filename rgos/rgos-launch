TAIL_BYTES = 256 * 1024
NATIVE_LOG_MAX = 1024 * 1024
NATIVE_LOG_KEEP = 256 * 1024


def tail(path, n=12):
    """Last n lines of a file, reading only its end (logs can be huge and live in RAM)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - TAIL_BYTES))
            data = f.read()
    except OSError:
        return ""
    # split on "\n" only: str.splitlines() also breaks on "\r" (wget/unzip progress bars) and other control
    # characters, so a progress-heavy port log would fill the last n "lines" with fragments of one bar
    lines = re.findall(r"[^\n]*\n|[^\n]+", data.decode("utf-8", "replace"))
    return "".join(lines[-n:])


def trim_log(path, limit=NATIVE_LOG_MAX, keep=NATIVE_LOG_KEEP):
    """Cap an append-only log. /var is a tmpfs, so an untrimmed port log would eat RAM until reboot."""
    try:
        if os.path.getsize(path) <= limit:
            return
        with open(path, "rb") as f:
            f.seek(-keep, os.SEEK_END)
            data = f.read()
        nl = data.find(b"\n")
        data = data[nl + 1:] if nl >= 0 else data
        tmp = path + ".tmp"
        with open(tmp, "wb") as f:
            f.write(b"[older output trimmed]\n" + data)
        os.replace(tmp, path)
    except OSError:
        pass


def show_error(title, detail):
    log("%s\n%s" % (title, detail))
    try:
        with open(TTY, "w") as t:
            t.write("\n%s\n%s\n" % (title, detail))
    except OSError:
        pass
    time.sleep(0 if os.environ.get("RGOS_NO_HW") else 4)


def device_cfg():
    try:
        with open(os.environ.get("RGOS_DEVICE_FILE", "/etc/rgos-device")) as f:
            dev = f.read().strip()
    except OSError:
        return None
    p = os.path.join(os.path.dirname(RA_CFG), "retroarch-%s.cfg" % dev) if dev.replace("-", "").isalnum() else None
    return p if p and os.path.isfile(p) else None


def perf_governor(sid):
    try:
        with open(os.path.join(BOOT_DIR, "rgos-governor.txt")) as f:
            w = f.read().split()
        if w and re.fullmatch(r"[a-z_]+", w[0]):
            return "" if w[0] == "default" else w[0]
    except OSError:
        pass
    return "performance" if sid in HEAVY_SYSTEMS else ""


def governor_nodes():
    return sorted(glob.glob(os.path.join(SYS_ROOT, "devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor"))
                  + glob.glob(os.path.join(SYS_ROOT, "class/devfreq/*/governor")))


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def set_governor(gov):
    if not gov:
        return {}
    todo = {}
    for node in governor_nodes():
        d, base = os.path.split(node)
        avail = _read(os.path.join(d, "scaling_available_governors" if base == "scaling_governor" else "available_governors"))
        prev = _read(node)
        if prev and prev != gov and gov in avail.split():
            todo[node] = prev
    for node in todo:
        try:
            with open(node, "w") as f:
                f.write(gov)
        except OSError as e:
            log("cannot set governor on %s: %s" % (node, e))
    if todo:
        log("governor %s on %d nodes" % (gov, len(todo)))
    return todo


def restore_governor(saved):
    for node, prev in saved.items():
        try:
            with open(node, "w") as f:
                f.write(prev)
        except OSError:
            pass


def set_game_flag(on, **info):
    """Create / remove the "a game is running" flag. The info (kind, title, pid) is read by gamemenu.py."""
    try:
        if on:
            os.makedirs(RUN_DIR, exist_ok=True)
            with open(GAME_FLAG, "w") as f:
                if info:
                    json.dump(info, f)
        else:
            os.remove(GAME_FLAG)
    except OSError:
        pass


def set_game_pid(pid):
    """Add the port's pid to the flag (only while the flag exists), so the in-game menu can pause and stop it."""
    try:
        with open(GAME_FLAG) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return
    if isinstance(data, dict):
        data["pid"] = pid
        try:
            with open(GAME_FLAG, "w") as f:
                json.dump(data, f)
        except OSError:
            pass


def consume_restart():
    """True once if the in-game menu asked for a restart (and clears the request)."""
    path = os.path.join(RUN_DIR, "restart")
    try:
        os.remove(path)
        return True
    except OSError:
        return False


def game_title(path):
    """Return a clean display title; PICO-8 PNG carts use a double extension (.p8.png)."""
    name = os.path.basename(path or "")
    title = os.path.splitext(name)[0]
    if title.lower().endswith(".p8") and name.lower().endswith(".png"):
        title = title[:-3]
    return title


def ra_verbose():
    return bool(os.environ.get("RGOS_RA_VERBOSE")) or os.path.exists(os.path.join(BOOT_DIR, "retroarch-verbose.txt"))


def game_priority():
    try:
        os.setpriority(os.PRIO_PROCESS, 0, -5)
    except OSError:
        pass


def unload_menu():
    for name in [m for m in sys.modules if m == "menu" or m == "pygame" or m.startswith("pygame.")]:
        del sys.modules[name]
    gc.collect()


def build_command(core_path, content, roms_root, cfg_run, verbose=None):
    appends = [cfg_run]
    dev_cfg = device_cfg()
    if dev_cfg:
        appends.insert(0, dev_cfg)
    user = os.path.join(roms_root, "config", "retroarch.cfg")
    if os.path.isfile(user):
        appends.append(user)
    cmd = [RA_BIN] + (["--verbose"] if (ra_verbose() if verbose is None else verbose) else []) + ["--log-file", LOG, "--config", RA_CFG, "--appendconfig", "|".join(appends)]
    if core_path:
        cmd += ["-L", core_path]
    if content:
        cmd.append(content)
    else:
        cmd.append("--menu")
    return cmd


def kernel_hints(n=40):
    if os.environ.get("RGOS_NO_HW"):
        return ""
    try:
        out = subprocess.run(["dmesg"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    keep = [l for l in out.splitlines() if re.search(r"segfault|out of memory|oom|killed process|panfrost|mali|drm.*(error|fail)|retroarch|dolphin|mupen|yaba", l, re.I)]
    return "\n".join(keep[-n:])


LOGS_SUBDIR = "logs"


def logs_dir(boot_dir=None):
    """<boot>/logs, created on demand; falls back to the boot partition root if the folder cannot be made."""
    base = boot_dir or BOOT_DIR
    path = os.path.join(base, LOGS_SUBDIR)
    try:
        os.makedirs(path, exist_ok=True)
        return path
    except OSError:
        return base


def save_report(pads, idx, drv, cmd, rc, history=(), core_path=""):
    try:
        with open(os.path.join(logs_dir(), "rgos-retroarch.txt"), "w") as f:
            f.write("== %s rc=%s (%s)\ncmd: %s\npads (jsN, name): %s\nhub pad: %s   joypad driver: %s\n"
                    % (time.strftime("%Y-%m-%d %H:%M:%S"), rc, rc_text(rc), " ".join(cmd), pads, idx, drv))
            if core_path:
                f.write("core: %s\nmissing libraries: %s\n" % (core_path, ", ".join(missing_libs(core_path)) or "none"))
            for n, (video, hrc, hdt, htail) in enumerate(history, 1):
                f.write("\n--- earlier attempt %d: video_driver=%s, %s after %.1fs; log tail:\n%s\n" % (n, video or "default", rc_text(hrc), hdt, htail))
            for path in ("/proc/bus/input/devices", RUN_DIR + "/retroarch-run.cfg"):
                f.write("\n--- %s\n" % path)
                try:
                    f.write(open(path, errors="replace").read())
                except OSError as e:
                    f.write("(%s)\n" % e)
            f.write("\n--- kernel messages (segfault / OOM / GPU)\n" + (kernel_hints() or "(none)\n"))
            f.write("\n--- retroarch log (last 150 lines)\n" + tail(LOG, 150))
        os.sync()
    except OSError:
        pass


def native_env(base=None, cwd=None):
    """Environment for a Linux port: the menu's own SDL/RG OS settings must not leak into it.

    rgos-session exports SDL_VIDEODRIVER=dummy (the menu draws straight to the framebuffer),
    which would leave every SDL port without a display, so SDL is left to pick its real driver.
    """
    env = dict(os.environ if base is None else base)
    for k in [k for k in env if k.startswith("RGOS_") and k not in ("RGOS_NO_HW",)]:
        del env[k]
    if env.get("SDL_VIDEODRIVER", "") in ("dummy", "offscreen", ""):
        env.pop("SDL_VIDEODRIVER", None)
    env["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:" + env.get("PATH", "")
    env.update({"HOME": "/root", "XDG_RUNTIME_DIR": RUN_DIR, "XDG_DATA_HOME": "/root/.local/share",
                "XDG_CONFIG_HOME": "/root/.config"})
    dev = alsa_device()
    env.setdefault("AUDIODEV", dev)
    if env.get("SDL_AUDIODRIVER", "") in ("", "dummy"):
        env["SDL_AUDIODRIVER"] = "alsa"
    try:  # SDL controller mapping for the hub pad; a failure here must never stop a port from starting
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import portpad
        env.update(portpad.env_for(env, RUN_DIR, ROMS_ROOT, cwd))
    except Exception as e:
        log("controller mapping unavailable: %s" % e)
    return env


def link_roms_alias():
    """PortMaster-style launchers look for /roms/ports; point /roms at the ROMS partition's roms folder."""
    src = os.path.join(ROMS_ROOT, "roms")
    if os.environ.get("RGOS_NO_HW") or not os.path.isdir(src) or os.path.lexists("/roms"):
        return
    try:
        os.symlink(src, "/roms")
    except OSError as e:
        log("cannot link /roms -> %s: %s" % (src, e))


def fix_crlf(path):
    """Scripts copied from Windows have CRLF line endings, which breaks every command in bash/sh."""
    try:
        with open(path, "rb") as f:
            data = f.read()
        if b"\r\n" not in data:
            return path
        # Self-extracting installers (PortMaster's makeself .sh) carry a binary archive after the script;
        # rewriting its CR LF bytes corrupts it ("Unexpected archive size"), so only touch pure text files.
        if b"\x00" in data:
            return path
        try:
            data.decode("utf-8")
        except UnicodeDecodeError:
            return path
        fixed = data.replace(b"\r\n", b"\n")
        try:
            with open(path, "wb") as f:
                f.write(fixed)
            log("converted CRLF line endings in %s" % path)
            return path
        except OSError:
            alt = os.path.join(RUN_DIR, "native-" + os.path.basename(path))
            os.makedirs(RUN_DIR, exist_ok=True)
            with open(alt, "wb") as f:
                f.write(fixed)
            log("%s is read-only; running a CRLF-fixed copy %s" % (path, alt))
            return alt
    except OSError as e:
        log("cannot check line endings of %s: %s" % (path, e))
        return path


def call_native(cmd, prio=False, **kw):
    """Run a port in its own session and watch for the Select+Start hold that stops it.

    Returns (returncode, stopped_by_user). The pad watcher is best effort: without a hub pad
    the port simply runs unwatched.
    """
    def child():
        if prio:
            game_priority()
    proc = subprocess.Popen(cmd, start_new_session=True, preexec_fn=child, **kw)
    set_game_pid(proc.pid)
    watcher = None
    try:
        import portexit
        fds = portexit.open_events(portexit.find_pad_events(SYS_INPUT, os.environ.get("RGOS_DEV_INPUT", "/dev/input"), HUB_NAME))
        if fds:
            watcher = portexit.ExitWatcher(fds, proc.pid, lambda: proc.poll() is None, log=log)
            watcher.start()
    except Exception as e:
        log("exit hold unavailable: %s" % e)
    try:
        rc = proc.wait()
    finally:
        if watcher:
            watcher.stop()
            watcher.join(1.0)
    return rc, bool(watcher and watcher.fired)


def launch_native(target):
    """Run a Linux port directly; no RetroArch core or emulator is involved."""
    target = os.path.abspath(target)
    if not os.path.isfile(target):
        show_error("RG OS: native port not found", target)
        return 127
    if target.lower().endswith((".sh", ".bash")):
        try:
            with open(target, "r", errors="replace") as f:
                first = f.readline().strip()
        except OSError as e:
            show_error("RG OS: cannot read native port", str(e))
            return 127
        shell = shutil.which("bash") if "bash" in first else shutil.which("sh")
        if not shell and "bash" not in first:
            shell = shutil.which("bash")
        if not shell:
            show_error("RG OS: shell unavailable", "Cannot run %s: its script interpreter is missing." % target)
            return 127
        cmd = [shell, fix_crlf(target)]
    else:
        if not os.access(target, os.X_OK):
            show_error("RG OS: native port is not executable", target + "\nMake the binary executable or provide a .sh launcher.")
            return 126
        cmd = [target]
    os.makedirs(RUN_DIR, exist_ok=True)
    cwd = os.path.dirname(target)
    env = native_env(cwd=cwd)
    link_roms_alias()
    os.makedirs(os.path.dirname(NATIVE_LOG) or ".", exist_ok=True)
    log("native port starting: %s (cwd=%s)" % (" ".join(cmd), cwd))
    hw = not os.environ.get("RGOS_NO_HW") or os.environ.get("RGOS_SYSFS")
    saved = set_governor(perf_governor("native")) if hw else {}
    consume_restart()
    set_game_flag(True, kind="native", title=game_title(target))
    started = time.monotonic()
    try:
        trim_log(NATIVE_LOG)
        with open(NATIVE_LOG, "a") as out:
            out.write("\n[%s] %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), " ".join(cmd)))
            out.flush()
            while True:
                rc, stopped = call_native(cmd, prio=not os.environ.get("RGOS_NO_HW"), cwd=cwd, env=env,
                                          stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
                if not consume_restart():
                    break
                log("native port restarted from the in-game menu")
                started = time.monotonic()
    except OSError as e:
        log("native port failed: %s" % e)
        show_error("RG OS: native port failed to start", str(e))
        return 127
    finally:
        set_game_flag(False)
        restore_governor(saved)
    dt = time.monotonic() - started
    log("native port exited rc=%s after %.1fs" % (rc, dt))
    save_native_report("native port", cmd, rc, dt, cwd, stopped)
    if stopped:
        log("native port was stopped by the Select+Start hold")
        return 0
    if rc != 0 and dt < EARLY_FAIL_S:
        show_error("RG OS: native port exited with an error (%s)" % rc_text(rc), "%s\nLog: %s" % (tail(NATIVE_LOG, 8), NATIVE_LOG))
    return rc

# Tools a PortMaster-style launcher shells out to. The root is a read-only squashfs, so anything the image
# does not ship is simply absent at run time (the old boot-time "busybox --install" cannot write there).
PORT_TOOLS = ("bash", "unzip", "wget", "curl", "xxd", "pkill", "pgrep", "pidof", "killall", "ps", "mount", "python3")


def save_native_report(what, cmd, rc, dt, cwd, stopped=False, boot_dir=None):
    """Write logs/rgos-native.txt on the FAT boot partition after every native port / PortMaster run.

    rgos-logs.txt is only written 8, 28 and 58 s after boot, so a port started later never showed up in any
    file on the card (and the boot-time snapshot printed "cannot open rgos-native.log" for a log that did not
    exist yet). This report is written when the port ends, so the card always carries the last run's evidence.
    """
    try:
        path = os.path.join(logs_dir(boot_dir), "rgos-native.txt")
        missing = [t for t in PORT_TOOLS if not shutil.which(t)]
        with open(path, "w") as f:
            f.write("== %s %s rc=%s (%s) after %.1fs%s\ncmd: %s\ncwd: %s\n"
                    % (time.strftime("%Y-%m-%d %H:%M:%S"), what, rc, rc_text(rc), dt,
                       " (stopped by Select+Start)" if stopped else "", " ".join(cmd), cwd))
            f.write("missing tools: %s\n" % (", ".join(missing) or "none"))
            try:
                with open("/proc/meminfo") as m:
                    mem = [l.strip() for l in m if l.startswith(("MemTotal", "MemAvailable"))]
            except OSError:
                mem = []
            f.write("memory: %s\n" % (" | ".join(mem) or "unknown"))
            try:
                with open("/proc/mounts") as m:
                    loops = [l.strip() for l in m if "squashfs" in l or "/dev/loop" in l]
            except OSError:
                loops = []
            f.write("squashfs / loop mounts:\n%s\n" % ("\n".join(loops) or "(none)"))
            try:
                names = sorted(os.listdir(cwd))[:60]
            except OSError as e:
                names = ["(%s)" % e]
            f.write("\n--- %s\n%s\n" % (cwd, "\n".join(names)))
            f.write("\n--- kernel messages (segfault / OOM / GPU)\n" + (kernel_hints() or "(none)\n"))
            f.write("\n--- rgos-launch log (last 40 lines)\n" + (tail(LAUNCH_LOG, 40) or "(empty)\n"))
            f.write("\n--- native log (last 150 lines)\n" + (tail(NATIVE_LOG, 150) or "(empty: the port printed nothing)\n"))
        os.sync()
    except Exception as e:  # a report must never turn a port exit into a crash
        log("cannot write rgos-native.txt: %s" % e)


def launch_retroarch(sid, core, core_path, content):
    os.makedirs(RUN_DIR, exist_ok=True)
    make_dirs(sid, ROMS_ROOT)
    cfg_run = os.path.join(RUN_DIR, "retroarch-run.cfg")
    pads = pad_nodes()
    idx, drv = hub_index(pads), joypad_driver()
    log("pads: %s; hub pad: %s; joypad driver: %s" % (pads or "none", ("js%d" % idx) if idx is not None else "NOT FOUND", drv))
    audio, font = alsa_device(), osd_font()
    env = dict(os.environ)
    env.update({"HOME": "/root", "XDG_RUNTIME_DIR": RUN_DIR, "SDL_VIDEODRIVER": "dummy",
                "MESA_SHADER_CACHE_DIR": "/tmp/mesa-cache", "SDL_AUDIODRIVER": "dummy"})
    if not os.environ.get("RGOS_NO_HW"):
        os.makedirs("/tmp/retroarch", exist_ok=True)
    hw = not os.environ.get("RGOS_NO_HW") or os.environ.get("RGOS_SYSFS")
    hw_video = sid in HW_VIDEO and not (sid == "saturn" and core == "mednafen_saturn")
    attempts = video_attempts(sid, core=core)
    if sid in ("gc", "n64", "saturn") and len(attempts) == 1 and hw_video:
        attempts = attempts + attempts  # a pinned driver still gets the safe-options retry
    history, rc, cmd = [], 0, []
    for n, video in enumerate(attempts):
        if sid == "gc":
            gc_opts = gc_core_options(ROMS_ROOT, RUN_DIR, safe=n > 0)
        elif sid in ("n64", "saturn"):
            gc_opts = core_options(sid, ROMS_ROOT, RUN_DIR, safe=n > 0, core=core)
        else:
            gc_opts = None
        if gc_opts and n > 0:
            log("%s retry with safe core options" % sid)
        with open(cfg_run, "w") as f:
            f.write(run_config(sid, ROMS_ROOT, audio, idx, drv, font, video, gc_opts))
        cmd = build_command(core_path, content, ROMS_ROOT, cfg_run, verbose=True if hw_video else None)
        log("starting%s: %s" % (" (video_driver %s)" % video if video else "", " ".join(cmd)))
        t0 = time.monotonic()
        saved = set_governor(perf_governor(sid)) if hw else {}
        set_game_flag(True, kind="retroarch", title=game_title(content) or "RetroArch")
        try:
            rc = subprocess.call(cmd, env=env, stdin=subprocess.DEVNULL,
                                 preexec_fn=None if os.environ.get("RGOS_NO_HW") else game_priority)
        except OSError as e:
            show_error("RG OS: cannot start RetroArch", str(e))
            return 1
        finally:
            set_game_flag(False)
            restore_governor(saved)
        dt = time.monotonic() - t0
        log("retroarch exited rc=%s (%s) after %.1fs" % (rc, rc_text(rc), dt))
        # A clean exit (rc 0) that ran past the early-failure window is the player quitting: a stray "[ERROR]" line in the
        # log (a missing optional file, a failed save at shutdown) must not relaunch the game under them.
        failed = rc != 0 or (dt < EARLY_FAIL_S and "[ERROR]" in tail(LOG, 40))
        if hw_video and failed and gl_mismatch(tail(LOG, 60)):
            log("%s core needs desktop OpenGL but RetroArch is a GLES build; retrying cannot help" % sid)
            break
        if hw_video and failed and dt < GC_RETRY_S and n + 1 < len(attempts):
            history.append((video, rc, dt, tail(LOG, 60)))
            log("%s failed to start with video_driver %s; retrying with %s" % (sid, video, attempts[n + 1]))
            continue
        break
    save_report(pads, idx, drv, cmd, rc, history, core_path)
    if dt < EARLY_FAIL_S and (rc != 0 or "[ERROR]" in tail(LOG, 40)):
        detail = tail(LOG)
        if gl_mismatch(tail(LOG, 60)):
            detail = GL_MISMATCH_HELP % (core or "emulator", core or "name") + "\n\n" + detail
        show_error("RG OS: %s failed to start (%s)" % (core or "RetroArch", rc_text(rc)), detail)
    return rc


def portmaster_script():
    """Find the PortMaster entry point on the active ROMS partition."""
    roots = [ROMS_ROOT, "/roms"]
    seen = set()
    for root in roots:
        if not root or root in seen:
            continue
        seen.add(root)
        for ports in (os.path.join(root, "roms", "ports"), os.path.join(root, "ports")):
            found = _portmaster_in(ports)
            if found:
                return found
    return ""


def _portmaster_in(ports):
    for path in (os.path.join(ports, "PortMaster", "PortMaster.sh"),
                 os.path.join(ports, "PortMaster", "portmaster.sh"),
                 os.path.join(ports, "PortMaster.sh"),
                 os.path.join(ports, "portmaster.sh")):
        if os.path.isfile(path):
            return path
    # Accommodate case variations used by community installs.
    try:
        for entry in os.listdir(ports):
            if entry.lower() == "portmaster":
                for name in ("PortMaster.sh", "portmaster.sh"):
                    path = os.path.join(ports, entry, name)
                    if os.path.isfile(path):
                        return path
    except OSError:
        pass
    return ""


def launch_portmaster():
    """Run PortMaster like any native port: its output goes to rgos-native.log, and an early exit is shown.

    PortMaster's own output used to go to the console / rgos-launch.log, so when its GUI died right after
    the splash the menu simply came back with no trace of why. Now everything it prints (including the
    Python traceback of a crashing GUI) is kept in rgos-native.log and its tail is shown on screen.
    """
    script = portmaster_script()
    if not script:
        show_error("RG OS: PortMaster is not installed",
                   "Expected PortMaster.sh in %s/ports/PortMaster or %s/ports. "
                   "Install PortMaster on the ROMS partition, then try again." % (ROMS_ROOT, ROMS_ROOT))
        return 1
    shell = shutil.which("bash") or "/bin/sh"
    os.makedirs(RUN_DIR, exist_ok=True)
    cwd = os.path.dirname(script)
    env = native_env(cwd=cwd)
    # OpenAL Soft (LOVE) probes PipeWire first and prints errors because this image runs no PipeWire; ALSA is what is there.
    env.setdefault("ALSOFT_DRIVERS", "alsa")
    link_roms_alias()
    cmd = [shell, fix_crlf(script)]
    log("starting PortMaster: %s" % script)
    hw = not os.environ.get("RGOS_NO_HW") or os.environ.get("RGOS_SYSFS")
    saved = set_governor(perf_governor("native")) if hw else {}
    set_game_flag(True, kind="native", title="PortMaster")
    started = time.monotonic()
    try:
        os.makedirs(os.path.dirname(NATIVE_LOG) or ".", exist_ok=True)
        trim_log(NATIVE_LOG)
        with open(NATIVE_LOG, "a") as out:
            out.write("\n[%s] %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), " ".join(cmd)))
            out.flush()
            rc, stopped = call_native(cmd, prio=not os.environ.get("RGOS_NO_HW"), cwd=cwd, env=env,
                                      stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
            out.write("[PortMaster exited rc=%s (%s)]\n" % (rc, rc_text(rc)))
    except OSError as e:
        show_error("RG OS: cannot start PortMaster", str(e))
        return 1
    finally:
        set_game_flag(False)
        restore_governor(saved)
    dt = time.monotonic() - started
    log("PortMaster exited rc=%s (%s) after %.1fs%s" % (rc, rc_text(rc), dt, " after the Select+Start hold" if stopped else ""))
    save_native_report("PortMaster", cmd, rc, dt, cwd, stopped)
    if stopped:
        return 0
    # PortMaster that quits within seconds, even with rc 0, crashed or could not start its GUI: say why.
    if (rc != 0 and dt < PORTMASTER_EARLY_FAIL_S) or dt < EARLY_FAIL_S:
        show_error("RG OS: PortMaster closed after %.0f s (%s)" % (dt, rc_text(rc)),
                   "%s\nLog: %s" % (tail(NATIVE_LOG, 10), NATIVE_LOG))
    return rc


def main(argv):
    target = (argv[1] if len(argv) > 1 else "").strip()
    if not target:
        log("no target")
        return 0
    state = load_json(STATE_FILE, {})
    if target == "@tool:retroarch":
        launch_retroarch("", "", "", "")
        return 0
    if target == "@tool:portmaster":
        launch_portmaster()
        return 0
    if target.startswith("@"):
        log("target %s is not supported by this build" % target)
        return 0
    if not os.path.isfile(target):
        show_error("RG OS: file not found", target)
        return 0
    sid = system_of(target)
    if sid == "ports":
        unload_menu()
        launch_native(target)
        return 0
    default_core, compatible_cores = menu_api()
    core = pick_core(sid, state, default_core, compatible_cores)
    if not core:
        show_error("RG OS: no emulator installed for '%s'" % (sid or "?"),
                   "Looked for cores in: %s" % ", ".join(CORE_DIRS))
        return 0
    log("%s: system=%s core=%s" % (target, sid, core))
    default_core = compatible_cores = None
    unload_menu()
    path = core_file(core)
    gone = missing_libs(path)
    if gone:
        show_error("RG OS: %s cannot load, libraries missing" % core, "%s\nRebuild the image (see docs/GAMECUBE.md) or install them." % ", ".join(gone))
        save_report([], None, "", [RA_BIN, "-L", path, target], 127, (), path)
        return 0
    if core == "dolphin":
        ok, why = ensure_dolphin_sys(ROMS_ROOT)
        if not ok:
            show_error("RG OS: Dolphin data folder is not usable", why)
            return 0
    launch_retroarch(sid, core, path, target)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
