def _release_stamp():
    try:
        with open(RELEASE_FILE) as f:
            return f.read().strip() or "1"
    except OSError:
        return "1"


def copy_tree(src, dst):
    errs = []
    for root, _dirs, files in os.walk(src):
        rel = os.path.relpath(root, src)
        out = dst if rel == "." else os.path.join(dst, rel)
        try:
            os.makedirs(out, exist_ok=True)
        except OSError as e:
            errs.append("%s: %s" % (out, e))
            continue
        for name in files:
            sp = os.path.join(root, name)
            if os.path.islink(sp) and not os.path.exists(sp):
                continue
            try:
                shutil.copyfile(sp, os.path.join(out, name))
            except OSError as e:
                errs.append("%s: %s" % (sp, e))
    return errs


def ensure_dolphin_sys(roms_root, src=None):
    src = src or DOLPHIN_SYS_SRC
    dst = os.path.join(roms_root, "bios", "dolphin-emu", "Sys")
    if not os.path.isdir(src):
        return os.path.isdir(dst), "no Dolphin Sys folder in the image (%s)" % src
    stamp, mark = _release_stamp(), os.path.join(dst, SYS_MARK)
    try:
        with open(mark) as f:
            if f.read().strip() == stamp:
                return True, ""
    except OSError:
        pass
    errs = copy_tree(src, dst)
    if errs:
        log("Dolphin Sys copy to %s had %d errors, first: %s" % (dst, len(errs), errs[0]))
        return False, "cannot copy Dolphin Sys to %s: %s" % (dst, errs[0])
    try:
        with open(mark, "w") as f:
            f.write(stamp + "\n")
    except OSError as e:
        log("cannot write %s: %s" % (mark, e))
    return True, ""


def _ldd_marker(path):
    try:
        st = os.stat(path)
    except OSError:
        return ""
    key = re.sub(r"[^A-Za-z0-9._-]", "_", "%s.%d.%d" % (os.path.basename(path), st.st_mtime_ns, st.st_size))
    return os.path.join(RUN_DIR, "ldd-ok", key)


def missing_libs(path):
    """Libraries a core cannot find. A clean ldd run is remembered until reboot (/run is a tmpfs),
    because spawning ldd on every launch costs far more than the check is worth."""
    ldd = shutil.which("ldd")
    if not ldd or not path:
        return []
    marker = _ldd_marker(path)
    if marker and os.path.exists(marker):
        return []
    try:
        out = subprocess.run([ldd, path], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    gone = sorted({l.split("=>")[0].strip() for l in out.splitlines() if "not found" in l})
    if not gone and marker:
        try:
            os.makedirs(os.path.dirname(marker), exist_ok=True)
            open(marker, "w").close()
        except OSError:
            pass
    return gone


def rc_text(rc):
    if rc is not None and rc < 0:
        try:
            return "killed by %s" % signal.Signals(-rc).name
        except ValueError:
            return "killed by signal %d" % -rc
    return "code %s" % rc


def video_attempts(sid, boot_dir=None, core=None):
    # Beetle Saturn is a software renderer (hw_render=false); pinning the GLES driver is unnecessary and can
    # interfere with the software-rendered path. YabaSanshiro remains pinned to GLES.
    if sid == "saturn" and core == "mednafen_saturn":
        return [None]
    if sid not in HW_VIDEO:
        return [None]
    drivers, boot_file = HW_VIDEO[sid]
    try:
        with open(os.path.join(boot_dir or BOOT_DIR, boot_file)) as f:
            w = f.read().split()
        if w and re.fullmatch(r"[a-z0-9_]+", w[0]):
            return [w[0]]
    except OSError:
        pass
    return list(drivers)


def gl_mismatch(text):
