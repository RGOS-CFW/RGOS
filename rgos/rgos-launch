def game_priority():
    try:
        os.setpriority(os.PRIO_PROCESS, 0, -5)
    except OSError:
        pass
    try:                                    # on a 1 GB console the OOM killer must pick anything but the running game
        with open("/proc/self/oom_score_adj", "w") as f:
            f.write("-500")
    except OSError:
        pass


def free_memory_for_game():
    """Hand the page cache back before a heavy emulator starts (best effort): Dolphin wants ~100 MB of contiguous-ish
    memory plus a shader cache, and the cache of the menu's artwork / the squashfs would otherwise be what it fights with."""
    if os.environ.get("RGOS_NO_HW"):
        return
    try:
        os.sync()
        for path, val in (("/proc/sys/vm/drop_caches", "3"), ("/proc/sys/vm/compact_memory", "1")):
            try:
                with open(path, "w") as f:
                    f.write(val)
            except OSError:
                pass
    except OSError:
        pass


def unload_menu():
    for name in [m for m in sys.modules if m == "menu" or m == "pygame" or m.startswith("pygame.")]:
