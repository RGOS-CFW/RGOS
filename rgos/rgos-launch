#!/usr/bin/env python3
"""rgos-launch TARGET: run what the menu chose (called by rgos-session after the menu exits with code 10).

TARGET is the text the menu wrote to /run/rgos/launch:
  /media/roms/roms/gba/Game.gba   a ROM: the system is the folder under roms/, the core is the one picked in
                                  Settings > Emulators (state.json) or the system's default (menu.default_core)
  @tool:retroarch                 the RetroArch menu without content
  anything else (ports, PortMaster) is not supported by this build and is only logged.

What it does for a ROM: pick an installed core, create <ROMS>/saves/<system>, <ROMS>/states/<system>, <ROMS>/bios,
write /run/rgos/retroarch-run.cfg (those folders + the ALSA device) and start RetroArch with
  --config /etc/rgos/retroarch.cfg --appendconfig run.cfg[|<ROMS>/config/retroarch.cfg]
If RetroArch dies within a few seconds with an error, the last log lines are put on the console (tty1) so the failure is
visible on the device; the full log stays in /var/log/rgos-retroarch.log. Always returns 0: the session goes back to the menu.

Testing on a PC: RGOS_RA_BIN, RGOS_RA_CFG, RGOS_RUN, RGOS_ROMS, RGOS_CORE_DIRS, RGOS_STATE, RGOS_RA_LOG, RGOS_NO_HW=1
override the device paths.
"""
import gc, glob, shutil, json, os, re, signal, subprocess, sys, time

RA_BIN = os.environ.get("RGOS_RA_BIN", "retroarch")
RA_CFG = os.environ.get("RGOS_RA_CFG", "/etc/rgos/retroarch.cfg")
RUN_DIR = os.environ.get("RGOS_RUN", "/run/rgos")
ROMS_ROOT = os.environ.get("RGOS_ROMS", "/media/roms")
STATE_FILE = os.environ.get("RGOS_STATE", "/var/lib/rgos/state.json")
LOG = os.environ.get("RGOS_RA_LOG", "/var/log/rgos-retroarch.log")
CORE_DIRS = os.environ.get("RGOS_CORE_DIRS", "/usr/lib/libretro:/usr/lib/aarch64-linux-gnu/libretro:/usr/local/lib/libretro").split(":")
TTY = os.environ.get("RGOS_TTY", "/dev/tty1")
SYS_INPUT = os.environ.get("RGOS_SYS_INPUT", "/sys/class/input")
BOOT_DIR = os.environ.get("RGOS_BOOT_DIR", "/boot")
HUB_NAME = "RG OS Gamepad"
EARLY_FAIL_S = 6.0
SYS_ROOT = os.environ.get("RGOS_SYSFS", "/sys")
GAME_FLAG = os.path.join(RUN_DIR, "ingame")
HEAVY_SYSTEMS = frozenset(("psx", "gc", "n64", "dreamcast", "saturn", "psp"))
DOLPHIN_SYS_SRC = os.environ.get("RGOS_DOLPHIN_SYS", "/usr/local/share/rgos/dolphin-emu/Sys")
RELEASE_FILE = os.environ.get("RGOS_RELEASE_FILE", "/etc/rgos-release")
SYS_MARK = ".rgos-sys-stamp"
GC_RETRY_S = 30.0          # a GameCube launch that dies sooner than this is retried with the next video driver
GC_VIDEO_DRIVERS = ("glcore", "gl")

FALLBACK_DEFAULT = {"gba": "mgba", "gb": "gambatte", "gbc": "gambatte", "nes": "nestopia"}
FALLBACK_COMPAT = {"gba": ("mgba",), "gb": ("gambatte", "mgba"), "gbc": ("gambatte", "mgba"), "nes": ("nestopia", "fceumm")}


def log(msg):
    sys.stderr.write("rgos-launch: %s\n" % msg)
    sys.stderr.flush()


def system_of(path):
    """'/media/roms/roms/gba/x.gba' -> 'gba' (the folder directly under the last 'roms' component); '' if none."""
    parts = os.path.normpath(path).split(os.sep)
    for i in range(len(parts) - 2, 0, -1):
        if parts[i - 1] == "roms":
            return parts[i]
    return ""


def core_file(core, dirs=None):
    """Full path of <core>_libretro.so in the first core directory that has it, else ''."""
    for d in (CORE_DIRS if dirs is None else dirs):
        p = os.path.join(d, core + "_libretro.so")
        if os.path.isfile(p):
            return p
    return ""


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def menu_api():
    """(default_core, compatible_cores) from the menu module so there is one table of truth; fallback tables otherwise."""
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import menu
        return menu.default_core, menu.compatible_cores
    except Exception as e:
        log("menu module not usable (%s); using built-in core tables" % e)
        return (lambda sid: FALLBACK_DEFAULT.get(sid, "")), (lambda sid, cores=None: [c for c in FALLBACK_COMPAT.get(sid, ()) if core_file(c)])


def pick_core(sid, state, default_core, compatible_cores):
    """The user's choice for this system if installed, else the system default if installed, else the first compatible core."""
    emus = state.get("emulators") if isinstance(state, dict) else None
    wanted = emus.get(sid) if isinstance(emus, dict) else None
    if not isinstance(wanted, str) or not wanted:
        wanted = default_core(sid)
    for c in (wanted, default_core(sid)):
        if c and core_file(c):
            return c
    for c in compatible_cores(sid):
        if core_file(c):
            return c
    return ""


def alsa_device():
    """plughw:<card>,0 for the card hwctl considers the speaker (first non-HDMI card); also un-mutes its outputs."""
    if os.environ.get("RGOS_NO_HW"):
        return "default"
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import hwctl
        card = hwctl.audio_card()
        try:
            hwctl.audio_enable(card)
        except Exception as e:
            log("audio_enable failed: %s" % e)
        return "plughw:%d,%d" % (card, hwctl.audio_pcm(card))
    except Exception as e:
        log("hwctl unusable (%s); ALSA device 'default'" % e)
        return "default"


def pad_nodes():
    """[(index N of /dev/input/jsN, device name)] sorted by N. RetroArch's linuxraw/udev joypad index is this N."""
    out = []
    for d in glob.glob(os.path.join(SYS_INPUT, "js[0-9]*")):
        m = re.fullmatch(r"js(\d+)", os.path.basename(d))
        try:
            with open(os.path.join(d, "device", "name")) as f:
                name = f.read().strip()
        except OSError:
            name = ""
        if m:
            out.append((int(m.group(1)), name))
    return sorted(out)


def hub_index(pads=None):
    """jsN of the hub's pad, else None. Without udevd nothing hides the raw (grabbed, silent) pad js0, so player 1 must
    be pointed at the hub explicitly or RetroArch listens to a dead device."""
    for n, name in (pad_nodes() if pads is None else pads):
        if name == HUB_NAME:
            return n
    return None


def joypad_driver():
    """RetroArch joypad driver. Default linuxraw (reads /dev/input/jsN directly: no udev, no SDL device classification).
    Put one word (linuxraw, sdl2 or udev) in /boot/retroarch-joypad.txt to try another one without rebuilding."""
    try:
        with open(os.path.join(BOOT_DIR, "retroarch-joypad.txt")) as f:
            w = f.read().split()
        if w and re.fullmatch(r"[a-z0-9]+", w[0]):
            return w[0]
    except OSError:
        pass
    return "linuxraw"


OSD_FONTS = ("/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
             "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")


def osd_font():
    """A TrueType font for RetroArch's on-screen messages (the volume indicator), '' if none is installed. Without one
    RetroArch falls back to its tiny built-in font, so only a font that really exists is passed on."""
    return next((p for p in OSD_FONTS if os.path.isfile(p)), "")


def run_config(sid, roms_root, audio_device, joy_index=None, joy_driver=None, font="", video_driver=None):
    """Text of the per-launch appendconfig. Folders are per system and live on the ROMS card so saves survive updates."""
    q = lambda p: '"%s"' % p
    lines = ['audio_device = %s' % q(audio_device)]
    if font:
        lines.append('video_font_path = %s' % q(font))
    if joy_driver:
        lines.append('input_joypad_driver = %s' % q(joy_driver))
    if video_driver:
        lines.append('video_driver = %s' % q(video_driver))
    if joy_index is not None:
        lines.append('input_player1_joypad_index = %s' % q(joy_index))
    lines += [
             'system_directory = %s' % q(os.path.join(roms_root, "bios")),
             'screenshot_directory = %s' % q(os.path.join(roms_root, "screenshots"))]
    if sid:
        lines += ['savefile_directory = %s' % q(os.path.join(roms_root, "saves", sid)),
                  'savestate_directory = %s' % q(os.path.join(roms_root, "states", sid))]
    else:
        lines += ['savefile_directory = %s' % q(os.path.join(roms_root, "saves")),
                  'savestate_directory = %s' % q(os.path.join(roms_root, "states"))]
    return "\n".join(lines) + "\n"


def make_dirs(sid, roms_root):
    for d in ([os.path.join(roms_root, "bios"), os.path.join(roms_root, "screenshots")]
              + ([os.path.join(roms_root, "saves", sid), os.path.join(roms_root, "states", sid)] if sid
                 else [os.path.join(roms_root, "saves"), os.path.join(roms_root, "states")])):
        try:
            os.makedirs(d, exist_ok=True)
        except OSError as e:
            log("cannot create %s: %s (saves may be lost)" % (d, e))


def _release_stamp():
    try:
        with open(RELEASE_FILE) as f:
            return f.read().strip() or "1"
    except OSError:
        return "1"


def copy_tree(src, dst):
    """Copy src into dst file by file (dst may already exist). Plain content copy only: shutil.copytree/copy2 also copy the
    permission bits, which the exFAT ROMS card refuses (EPERM), and that left a half-copied Sys folder behind. Returns the
    list of errors; broken symlinks in the source are skipped."""
    errs = []
    for root, _dirs, files in os.walk(src):
        rel = os.path.relpath(root, src)
        out = dst if rel == "." else os.path.join(dst, rel)
        try:
            os.makedirs(out, exist_ok=True)
        except OSError as e:
            errs.append("%s: %s" % (out, e))
            continue
        for name in files:
            sp = os.path.join(root, name)
            if os.path.islink(sp) and not os.path.exists(sp):
                continue
            try:
                shutil.copyfile(sp, os.path.join(out, name))
            except OSError as e:
                errs.append("%s: %s" % (sp, e))
    return errs


def ensure_dolphin_sys(roms_root, src=None):
    """The Dolphin core wants <system dir>/dolphin-emu/Sys. The image ships a copy; put it on the ROMS card (exFAT: no symlinks).
    A stamp file written only after a COMPLETE copy says the folder is good, so an interrupted or failed copy is redone on the
    next launch (before, the mere existence of the folder counted as done and the core then died on missing files), and a new
    image build refreshes the shipped files. Files the user added (IPL.bin) are never touched. Returns (ok, message)."""
    src = src or DOLPHIN_SYS_SRC
    dst = os.path.join(roms_root, "bios", "dolphin-emu", "Sys")
    if not os.path.isdir(src):
        return os.path.isdir(dst), "no Dolphin Sys folder in the image (%s)" % src
    stamp, mark = _release_stamp(), os.path.join(dst, SYS_MARK)
    try:
        with open(mark) as f:
            if f.read().strip() == stamp:
                return True, ""
    except OSError:
        pass
    errs = copy_tree(src, dst)
    if errs:
        log("Dolphin Sys copy to %s had %d errors, first: %s" % (dst, len(errs), errs[0]))
        return False, "cannot copy Dolphin Sys to %s: %s" % (dst, errs[0])
    try:
        with open(mark, "w") as f:
            f.write(stamp + "\n")
    except OSError as e:
        log("cannot write %s: %s" % (mark, e))
    return True, ""


def missing_libs(path):
    """Shared libraries that `ldd path` cannot find (names only). [] when ldd is not available or the file is fine."""
    ldd = shutil.which("ldd")
    if not ldd or not path:
        return []
    try:
        out = subprocess.run([ldd, path], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return sorted({l.split("=>")[0].strip() for l in out.splitlines() if "not found" in l})


def rc_text(rc):
    if rc is not None and rc < 0:
        try:
            return "killed by %s" % signal.Signals(-rc).name
        except ValueError:
            return "killed by signal %d" % -rc
    return "code %s" % rc


def video_attempts(sid, boot_dir=None):
    """Video drivers to try in order. Only the GameCube core needs a real GL context (the 2D cores run on whatever RetroArch
    picks), so only gc is pinned: glcore, then gl if the first launch dies at once. One word in /boot/retroarch-gc-video.txt
    (glcore, gl, vulkan, ...) forces a single choice. [None] = leave RetroArch's own driver."""
    if sid != "gc":
        return [None]
    try:
        with open(os.path.join(boot_dir or BOOT_DIR, "retroarch-gc-video.txt")) as f:
            w = f.read().split()
        if w and re.fullmatch(r"[a-z0-9_]+", w[0]):
            return [w[0]]
    except OSError:
        pass
    return list(GC_VIDEO_DRIVERS)


def tail(path, n=12):
    try:
        with open(path, errors="replace") as f:
            return "".join(f.readlines()[-n:])
    except OSError:
        return ""


def show_error(title, detail):
    log("%s\n%s" % (title, detail))
    try:
        with open(TTY, "w") as t:
            t.write("\n%s\n%s\n" % (title, detail))
    except OSError:
        pass
    time.sleep(0 if os.environ.get("RGOS_NO_HW") else 4)


def device_cfg():
    """/etc/rgos/retroarch-<device>.cfg (device = /etc/rgos-device) if the image ships one, else None. Per-device RetroArch binds,
    e.g. the RG34XXSP's analog sticks; it comes first in the append list so run.cfg and the user's retroarch.cfg can still override it."""
    try:
        with open(os.environ.get("RGOS_DEVICE_FILE", "/etc/rgos-device")) as f:
            dev = f.read().strip()
    except OSError:
        return None
    p = os.path.join(os.path.dirname(RA_CFG), "retroarch-%s.cfg" % dev) if dev.replace("-", "").isalnum() else None
    return p if p and os.path.isfile(p) else None


def perf_governor(sid):
    """Governor to force while the game runs, or '' to leave the system's own (battery-friendly) choice alone.
    Heavy systems (PSX, GameCube, N64, Dreamcast, Saturn, PSP) get 'performance' so the CPU/GPU/DRAM never sit at a low clock
    while a frame is being rendered. Put one word in /boot/rgos-governor.txt to override for every system
    (performance, schedutil, ondemand, ...; 'default' = never touch the governor)."""
    try:
        with open(os.path.join(BOOT_DIR, "rgos-governor.txt")) as f:
            w = f.read().split()
        if w and re.fullmatch(r"[a-z_]+", w[0]):
            return "" if w[0] == "default" else w[0]
    except OSError:
        pass
    return "performance" if sid in HEAVY_SYSTEMS else ""


def governor_nodes():
    return sorted(glob.glob(os.path.join(SYS_ROOT, "devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor"))
                  + glob.glob(os.path.join(SYS_ROOT, "class/devfreq/*/governor")))


def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def set_governor(gov):
    """Set `gov` on every cpufreq policy and devfreq device (GPU, DRAM) that offers it. Returns {node: previous governor}
    for restore_governor(). All previous values are read BEFORE anything is written: cores of one cpufreq policy share a
    governor, so reading cpu1 after writing cpu0 would record 'performance' as its original."""
    if not gov:
        return {}
    todo = {}
    for node in governor_nodes():
        d, base = os.path.split(node)
        avail = _read(os.path.join(d, "scaling_available_governors" if base == "scaling_governor" else "available_governors"))
        prev = _read(node)
        if prev and prev != gov and gov in avail.split():
            todo[node] = prev
    for node in todo:
        try:
            with open(node, "w") as f:
                f.write(gov)
        except OSError as e:
            log("cannot set governor on %s: %s" % (node, e))
    if todo:
        log("governor %s on %d nodes" % (gov, len(todo)))
    return todo


def restore_governor(saved):
    for node, prev in saved.items():
        try:
            with open(node, "w") as f:
                f.write(prev)
        except OSError:
            pass


def set_game_flag(on):
    try:
        if on:
            os.makedirs(RUN_DIR, exist_ok=True)
            open(GAME_FLAG, "w").close()
        else:
            os.remove(GAME_FLAG)
    except OSError:
        pass


def ra_verbose():
    """RetroArch's --verbose log costs CPU and SD-card writes every frame it logs. Off by default; touch
    /boot/retroarch-verbose.txt (or set RGOS_RA_VERBOSE=1) to get the full log for a bug report."""
    return bool(os.environ.get("RGOS_RA_VERBOSE")) or os.path.exists(os.path.join(BOOT_DIR, "retroarch-verbose.txt"))


def game_priority():
    """preexec for RetroArch: a higher scheduling priority than the background daemons (Wi-Fi, Bluetooth, input hub)."""
    try:
        os.setpriority(os.PRIO_PROCESS, 0, -5)
    except OSError:
        pass


def unload_menu():
    """menu.py is only imported for its core tables. Drop it (and pygame) before RetroArch starts: this process stays alive
    for the whole game and would otherwise keep the Python heap of a 168 KB module plus pygame resident on a 1 GB device."""
    for name in [m for m in sys.modules if m == "menu" or m == "pygame" or m.startswith("pygame.")]:
        del sys.modules[name]
    gc.collect()


def build_command(core_path, content, roms_root, cfg_run, verbose=None):
    appends = [cfg_run]
    dev_cfg = device_cfg()
    if dev_cfg:
        appends.insert(0, dev_cfg)
    user = os.path.join(roms_root, "config", "retroarch.cfg")
    if os.path.isfile(user):
        appends.append(user)
    cmd = [RA_BIN] + (["--verbose"] if (ra_verbose() if verbose is None else verbose) else []) + ["--log-file", LOG, "--config", RA_CFG, "--appendconfig", "|".join(appends)]
    if core_path:
        cmd += ["-L", core_path]
    if content:
        cmd.append(content)
    else:
        cmd.append("--menu")
    return cmd


def kernel_hints(n=40):
    """The last kernel lines that explain a silent death of the emulator (segfault, out-of-memory kill, GPU errors)."""
    if os.environ.get("RGOS_NO_HW"):
        return ""
    try:
        out = subprocess.run(["dmesg"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    keep = [l for l in out.splitlines() if re.search(r"segfault|out of memory|oom|killed process|panfrost|mali|drm.*(error|fail)|retroarch|dolphin", l, re.I)]
    return "\n".join(keep[-n:])


def save_report(pads, idx, drv, cmd, rc, history=(), core_path=""):
    """Copy what a PC needs to see why a game does not start to <boot>/rgos-retroarch.txt (the boot FAT partition)."""
    try:
        with open(os.path.join(BOOT_DIR, "rgos-retroarch.txt"), "w") as f:
            f.write("== %s rc=%s (%s)\ncmd: %s\npads (jsN, name): %s\nhub pad: %s   joypad driver: %s\n"
                    % (time.strftime("%Y-%m-%d %H:%M:%S"), rc, rc_text(rc), " ".join(cmd), pads, idx, drv))
            if core_path:
                f.write("core: %s\nmissing libraries: %s\n" % (core_path, ", ".join(missing_libs(core_path)) or "none"))
            for n, (video, hrc, hdt, htail) in enumerate(history, 1):
                f.write("\n--- earlier attempt %d: video_driver=%s, %s after %.1fs; log tail:\n%s\n" % (n, video or "default", rc_text(hrc), hdt, htail))
            for path in ("/proc/bus/input/devices", RUN_DIR + "/retroarch-run.cfg"):
                f.write("\n--- %s\n" % path)
                try:
                    f.write(open(path, errors="replace").read())
                except OSError as e:
                    f.write("(%s)\n" % e)
            f.write("\n--- kernel messages (segfault / OOM / GPU)\n" + (kernel_hints() or "(none)\n"))
            f.write("\n--- retroarch log (last 150 lines)\n" + tail(LOG, 150))
        os.sync()
    except OSError:
        pass


def launch_retroarch(sid, core, core_path, content):
    os.makedirs(RUN_DIR, exist_ok=True)
    make_dirs(sid, ROMS_ROOT)
    cfg_run = os.path.join(RUN_DIR, "retroarch-run.cfg")
    pads = pad_nodes()
    idx, drv = hub_index(pads), joypad_driver()
    log("pads: %s; hub pad: %s; joypad driver: %s" % (pads or "none", ("js%d" % idx) if idx is not None else "NOT FOUND", drv))
    audio, font = alsa_device(), osd_font()
    env = dict(os.environ)
    env.update({"HOME": "/root", "XDG_RUNTIME_DIR": RUN_DIR, "SDL_VIDEODRIVER": "dummy",
                "MESA_SHADER_CACHE_DIR": "/tmp/mesa-cache", "SDL_AUDIODRIVER": "dummy"})
    if not os.environ.get("RGOS_NO_HW"):
        os.makedirs("/tmp/retroarch", exist_ok=True)
    hw = not os.environ.get("RGOS_NO_HW") or os.environ.get("RGOS_SYSFS")
    attempts = video_attempts(sid)
    history, rc, cmd = [], 0, []
    for n, video in enumerate(attempts):
        with open(cfg_run, "w") as f:
            f.write(run_config(sid, ROMS_ROOT, audio, idx, drv, font, video))
        # The GameCube core always runs with RetroArch's verbose log: without it a core that fails to start leaves nothing to read.
        cmd = build_command(core_path, content, ROMS_ROOT, cfg_run, verbose=True if sid == "gc" else None)
        log("starting%s: %s" % (" (video_driver %s)" % video if video else "", " ".join(cmd)))
        t0 = time.monotonic()
        saved = set_governor(perf_governor(sid)) if hw else {}
        set_game_flag(True)
        try:
            rc = subprocess.call(cmd, env=env, stdin=subprocess.DEVNULL,
                                 preexec_fn=None if os.environ.get("RGOS_NO_HW") else game_priority)
        except OSError as e:
            show_error("RG OS: cannot start RetroArch", str(e))
            return 1
        finally:
            set_game_flag(False)
            restore_governor(saved)
        dt = time.monotonic() - t0
        log("retroarch exited rc=%s (%s) after %.1fs" % (rc, rc_text(rc), dt))
        failed = rc != 0 or "[ERROR]" in tail(LOG, 40)
        if sid == "gc" and failed and dt < GC_RETRY_S and n + 1 < len(attempts):
            history.append((video, rc, dt, tail(LOG, 60)))
            log("GameCube failed to start with video_driver %s; retrying with %s" % (video, attempts[n + 1]))
            continue
        break
    save_report(pads, idx, drv, cmd, rc, history, core_path)
    if dt < EARLY_FAIL_S and (rc != 0 or "[ERROR]" in tail(LOG, 40)):
        show_error("RG OS: %s failed to start (%s)" % (core or "RetroArch", rc_text(rc)), tail(LOG))
    return rc


def main(argv):
    target = (argv[1] if len(argv) > 1 else "").strip()
    if not target:
        log("no target")
        return 0
    state = load_json(STATE_FILE, {})
    if target == "@tool:retroarch":
        launch_retroarch("", "", "", "")
        return 0
    if target.startswith("@"):
        log("target %s is not supported by this build" % target)
        return 0
    if not os.path.isfile(target):
        show_error("RG OS: file not found", target)
        return 0
    sid = system_of(target)
    default_core, compatible_cores = menu_api()
    core = pick_core(sid, state, default_core, compatible_cores)
    if not core:
        show_error("RG OS: no emulator installed for '%s'" % (sid or "?"),
                   "Looked for cores in: %s" % ", ".join(CORE_DIRS))
        return 0
    log("%s: system=%s core=%s" % (target, sid, core))
    default_core = compatible_cores = None
    unload_menu()
    path = core_file(core)
    gone = missing_libs(path)
    if gone:
        show_error("RG OS: %s cannot load, libraries missing" % core, "%s\nRebuild the image (see docs/GAMECUBE.md) or install them." % ", ".join(gone))
        save_report([], None, "", [RA_BIN, "-L", path, target], 127, (), path)
        return 0
    if core == "dolphin":
        ok, why = ensure_dolphin_sys(ROMS_ROOT)
        if not ok:
            show_error("RG OS: Dolphin data folder is not usable", why)
            return 0
    launch_retroarch(sid, core, path, target)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
