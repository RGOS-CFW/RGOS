def run_config(sid, roms_root, audio_device, joy_index=None, joy_driver=None, font="", video_driver=None, core_options=None):
    q = lambda p: '"%s"' % p
    lines = ['audio_device = %s' % q(audio_device)]
    try:
        import hdmictl
        lines.extend(hdmictl.retroarch_lines())
    except Exception as e:
        log("HDMI RetroArch settings unavailable (%s)" % e)
    if font:
        lines.append('video_font_path = %s' % q(font))
    if joy_driver:
        lines.append('input_joypad_driver = %s' % q(joy_driver))
    if video_driver:
        lines.append('video_driver = %s' % q(video_driver))
    if sid == "gc":
        lines += ['%s = %s' % (k, q(v)) for k, v in GC_RUN_SETTINGS]
    if core_options:
        lines.append('core_options_path = %s' % q(core_options))
    if joy_index is not None:
        lines.append('input_player1_joypad_index = %s' % q(joy_index))
    lines += [
             'system_directory = %s' % q(os.path.join(roms_root, "bios")),
             'screenshot_directory = %s' % q(os.path.join(roms_root, "screenshots"))]
    if sid:
        lines += ['savefile_directory = %s' % q(os.path.join(roms_root, "saves", sid)),
                  'savestate_directory = %s' % q(os.path.join(roms_root, "states", sid))]
    else:
        lines += ['savefile_directory = %s' % q(os.path.join(roms_root, "saves")),
                  'savestate_directory = %s' % q(os.path.join(roms_root, "states"))]
    return "\n".join(lines) + "\n"


def read_option_overrides(path, prefix="dolphin_"):
    """key = "value" lines of the user's own option file; anything that does not start with prefix is ignored."""
    out = {}
    try:
        with open(path, errors="replace") as f:
            for line in f:
                m = re.fullmatch(r'\s*(%s[A-Za-z0-9_-]+)\s*=\s*"?([^"\r\n]*?)"?\s*' % re.escape(prefix), line)
                if m:
                    out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def gc_core_options(roms_root, run_dir, safe=False):
    """Write the Dolphin core options for this launch and return the file's path ("" if it cannot be written).

    Order of precedence: built-in tuned defaults < safe-mode changes (retry after a crash) < the user's own
    <ROMS>/config/dolphin-options.cfg. The file lives in the run directory, so it is rebuilt on every launch.
    """
    opts = dict(GC_CORE_OPTIONS)
    if platform.machine().lower() in ("x86_64", "amd64"):
        opts.update(GC_X86_OPTIONS)
    if safe:
        opts.update(GC_SAFE_OPTIONS)
    opts.update(read_option_overrides(os.path.join(roms_root, "config", GC_OPTIONS_NAME)))
    path = os.path.join(run_dir, GC_OPTIONS_NAME)
    try:
        os.makedirs(run_dir, exist_ok=True)
        with open(path, "w") as f:
            f.write("".join('%s = "%s"\n' % kv for kv in sorted(opts.items())))
    except OSError as e:
        log("cannot write Dolphin core options %s: %s" % (path, e))
        return ""
    return path


def saturn_has_bios(roms_root, names=SATURN_HLE_BIOS):
    """Check BIOS names understood by the selected Saturn core, not merely any Saturn firmware file."""
    bios_dir = os.path.join(roms_root, "bios")
    return any(os.path.isfile(os.path.join(bios_dir, n)) for n in names)


def core_options(sid, roms_root, run_dir, safe=False, core=None):
    """Write per-core options; defaults < safe retry < user overrides. Returns "" if no file can be written."""
    prefix = OPTION_PREFIX[sid]
    if sid == "n64":
        opts, safe_opts = dict(N64_CORE_OPTIONS), N64_SAFE_OPTIONS
    elif sid == "saturn":
        core = core or "yabasanshiro"
        if core == "yabasanshiro":
            opts, safe_opts = dict(SATURN_CORE_OPTIONS), SATURN_SAFE_OPTIONS
            if not saturn_has_bios(roms_root):
                opts["yabasanshiro_force_hle_bios"] = "enabled"
                log("no saturn_bios.bin in %s/bios; YabaSanshiro will use its HLE BIOS" % roms_root)
        elif core == "yabause":
            opts, safe_opts = dict(YABAUSE_CORE_OPTIONS), YABAUSE_SAFE_OPTIONS
            if not saturn_has_bios(roms_root):
                opts["yabause_force_hle_bios"] = "enabled"
                log("no saturn_bios.bin in %s/bios; Yabause will use its HLE BIOS" % roms_root)
            prefix = "yabause_"
        elif core == "mednafen_saturn":
            # Beetle is software-rendered and uses required region BIOS files, not YabaSanshiro options/HLE flags.
            opts, safe_opts, prefix = {}, {}, "beetle_saturn_"
        else:
            opts, safe_opts = {}, {}
    else:
        return ""
    if safe:
        opts.update(safe_opts)
    name = CORE_OPTIONS_NAME[sid]
    opts.update(read_option_overrides(os.path.join(roms_root, "config", name), prefix))
    path = os.path.join(run_dir, name)
    try:
        os.makedirs(run_dir, exist_ok=True)
        with open(path, "w") as f:
            f.write("".join('%s = "%s"\n' % kv for kv in sorted(opts.items())))
    except OSError as e:
        log("cannot write core options %s: %s" % (path, e))
        return ""
    return path


