def log(msg):
    sys.stderr.write("rgos-launch: %s\n" % msg)
    sys.stderr.flush()


def system_of(path):
    """System folder of a ROM: the name right after the first "roms" directory that is not the mount point.

    The partition is mounted at <...>/roms and holds a roms/ folder, so a "roms" followed by another "roms"
    is skipped. Later "roms" folders belong to the ROM set (arcade/roms/<game>.zip) and must not be matched.
    """
    parts = os.path.normpath(path).split(os.sep)
    for i in range(len(parts) - 2):
        if parts[i] == "roms" and parts[i + 1] != "roms":
            return parts[i + 1]
    return ""


def standalone_file(core, dirs=None):
    """Resolve a standalone emulator executable; never treat it as a libretro shared object."""
    exe = STANDALONE.get(core)
    if not exe:
        return ""
    for d in (STANDALONE_DIRS if dirs is None else dirs):
        path = os.path.join(d, exe)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return ""


def core_file(core, dirs=None):
    if core in STANDALONE:
        return standalone_file(core)
    for d in (CORE_DIRS if dirs is None else dirs):
        p = os.path.join(d, core + "_libretro.so")
        if os.path.isfile(p):
            return p
    return ""


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def menu_api():
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import cores  # tiny tables-only module: importing menu would pull in pygame for a lookup
        return cores.default_core, cores.compatible_cores
    except Exception as e:
        log("core tables not usable (%s); using built-in core tables" % e)
        return (lambda sid: FALLBACK_DEFAULT.get(sid, "")), (lambda sid, cores=None: [c for c in FALLBACK_COMPAT.get(sid, ()) if core_file(c)])


def pick_core(sid, state, default_core, compatible_cores):
    emus = state.get("emulators") if isinstance(state, dict) else None
    wanted = emus.get(sid) if isinstance(emus, dict) else None
    if not isinstance(wanted, str) or not wanted:
        wanted = default_core(sid)
    for c in (wanted, default_core(sid)):
        if c and core_file(c):
            return c
    for c in compatible_cores(sid):
        if core_file(c):
            return c
    return ""


def alsa_device():
    if os.environ.get("RGOS_NO_HW"):
        return "default"
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import hdmictl
        hdmi_audio = hdmictl.audio_device()
        if hdmi_audio:
            return hdmi_audio
    except Exception as e:
        log("HDMI audio detection unavailable (%s); using built-in audio" % e)
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import hwctl
        card = hwctl.audio_card()
        try:
            hwctl.audio_enable(card)
        except Exception as e:
            log("audio_enable failed: %s" % e)
        return "plughw:%d,%d" % (card, hwctl.audio_pcm(card))
    except Exception as e:
        log("hwctl unusable (%s); ALSA device 'default'" % e)
        return "default"


def pad_nodes():
    out = []
    for d in glob.glob(os.path.join(SYS_INPUT, "js[0-9]*")):
        m = re.fullmatch(r"js(\d+)", os.path.basename(d))
        try:
            with open(os.path.join(d, "device", "name")) as f:
                name = f.read().strip()
        except OSError:
            name = ""
        if m:
            out.append((int(m.group(1)), name))
    return sorted(out)


def hub_index(pads=None):
    for n, name in (pad_nodes() if pads is None else pads):
        if name == HUB_NAME:
            return n
    return None


def joypad_driver():
    try:
        with open(os.path.join(BOOT_DIR, "retroarch-joypad.txt")) as f:
            w = f.read().split()
        if w and re.fullmatch(r"[a-z0-9]+", w[0]):
            return w[0]
    except OSError:
        pass
    return "linuxraw"


