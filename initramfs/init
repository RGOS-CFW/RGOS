#!/bin/busybox sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin 2>/dev/null

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
[ -c /dev/console ] && exec </dev/console >/dev/console 2>&1

# Boot logo: paint bootlogo-<W>x<H>.raw (32-bit B,G,R,X rows, see tools/bmp2fb.py) onto the framebuffer as soon as it
# exists, so the screen is never blank between U-Boot's logo and the first RG OS screen. Only touches a 32 bpp
# framebuffer whose stride and width match the file; anything else is left alone.
paint_logo() {
  fb=/sys/class/graphics/fb0
  [ -c /dev/fb0 ] && [ "$(cat $fb/bits_per_pixel 2>/dev/null)" = 32 ] || return 1
  vs=$(cat $fb/virtual_size 2>/dev/null); w=${vs%%,*}
  [ -n "$w" ] && [ "$(cat $fb/stride 2>/dev/null)" = "$((w * 4))" ] || return 1
  for f in "$1"/bootlogo-"$w"x*.raw; do [ -f "$f" ] && cat "$f" > /dev/fb0 2>/dev/null && return 0; done
  return 1
}

echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
LOGO_PID=""
if [ -d /logo ]; then
  ( n=0; until paint_logo /logo; do n=$((n + 1)); [ "$n" -ge 100 ] && break; sleep 0.1 2>/dev/null || sleep 1; done ) &
  LOGO_PID=$!
fi

echo "0 4 1 7" > /proc/sys/kernel/printk 2>/dev/null
klog() { echo "rgos-initramfs: $*" > /dev/kmsg 2>/dev/null; }
say()  { klog "$*"; echo "RG OS: $*"; }

WANT=""
for a in $(cat /proc/cmdline); do case "$a" in boot=*) WANT=${a#boot=} ;; esac; done

# Make sure partition nodes exist even when devtmpfs is missing or slow: create them from /sys/class/block.
mknod_blocks() {
  for s in /sys/class/block/*; do
    [ -f "$s/dev" ] || continue
    nm=${s##*/}
    [ -b "/dev/$nm" ] && continue
    mm=$(cat "$s/dev" 2>/dev/null) || continue
    mknod "/dev/$nm" b "${mm%%:*}" "${mm##*:}" 2>/dev/null
  done
}

# A boot partition is the FAT partition that holds SYSTEM. After an interrupted update the file can be missing while a
# SYSTEM.prev (the old, known-good image) or a fully written SYSTEM.new is still there, so those count too and are used
# as a fallback instead of hanging here forever.
SYSFILE=""
pick_system() {
  [ -f /flash/SYSTEM ] && { SYSFILE=SYSTEM; return 0; }
  for f in SYSTEM.prev SYSTEM.new; do
    [ -f "/flash/$f" ] && { SYSFILE=$f; return 0; }
  done
  return 1
}

try_dev() {
  [ -b "$1" ] || return 1
  for fs in vfat exfat auto; do
    mount -t $fs -o rw,noatime "$1" /flash 2>/dev/null || mount -t $fs -o ro "$1" /flash 2>/dev/null || continue
    pick_system && return 0
    umount /flash 2>/dev/null
  done
  return 1
}

find_boot() {
  mknod_blocks
  if [ -n "$WANT" ]; then
    case "$WANT" in /dev/*) hint=$WANT ;; *) hint=$(findfs "$WANT" 2>/dev/null) ;; esac
    [ -n "$hint" ] && try_dev "$hint" && return 0
  fi
  for d in /dev/mmcblk*p[0-9]* /dev/sd[a-z][0-9]* /dev/nvme*n*p[0-9]*; do try_dev "$d" && return 0; done
  return 1
}

# Shown on screen while waiting, so a stuck boot says WHY instead of only "waiting...".
diag() {
  echo "RG OS: boot partition not found yet. Details:"
  bd=""; for x in /dev/mmcblk* /dev/sd[a-z]* /dev/nvme*; do [ -b "$x" ] && bd="$bd ${x#/dev/}"; done
  echo " block devices:$bd"
  echo " filesystems:   $(grep -e vfat -e exfat /proc/filesystems | tr -d '\t' | tr '\n' ' ')"
  for d in /dev/mmcblk*p[0-9]* /dev/sd[a-z][0-9]*; do
    [ -b "$d" ] || continue
    if mount -t auto -o ro "$d" /flash 2>/dev/null; then
      echo " $d: $(ls /flash | head -n 12 | tr '\n' ' ')"
      umount /flash 2>/dev/null
    else
      echo " $d: cannot be mounted"
    fi
  done
  echo " Fix: put the card in a PC; the FAT partition must contain SYSTEM."
  echo " If only SYSTEM.prev or SYSTEM.new is there, copy it as SYSTEM."
}

n=0
until find_boot; do
  n=$((n + 1))
  [ "$n" -eq 40 ] && say "waiting for the boot partition (the one with SYSTEM)..."
  [ "$n" -ge 60 ] && [ $((n % 120)) -eq 60 ] && diag
  sleep 0.25 2>/dev/null || sleep 1
done
[ "$SYSFILE" != SYSTEM ] && { say "SYSTEM is missing, booting from $SYSFILE"; klog "SYSTEM missing, using $SYSFILE"; }
klog "boot partition found after $n tries (boot=$WANT)"

TRACE=/flash/rgos-initramfs.txt
trace() { echo "[$(cut -d' ' -f1 /proc/uptime 2>/dev/null)] $*" >> "$TRACE" 2>/dev/null; }
{ echo "RG OS initramfs trace"; echo "cmdline: $(cat /proc/cmdline)"; echo "kernel: $(uname -r 2>/dev/null)"
  echo "boot partition: $(awk '$2=="/flash"{print $1; exit}' /proc/mounts) (tries: $n, boot=$WANT)"
  echo "--- /proc/partitions"; cat /proc/partitions 2>&1; } > "$TRACE" 2>/dev/null

n=0
until mount -t squashfs -o ro,loop "/flash/$SYSFILE" /sysroot 2>/dev/null; do
  n=$((n + 1))
  [ "$n" -eq 5 ] && { say "cannot mount /flash/$SYSFILE (card error? re-flash the image)"
    trace "cannot mount /flash/$SYSFILE as squashfs after $n tries; file is $(ls -l /flash/$SYSFILE 2>&1)"
    { echo "--- /proc/filesystems"; cat /proc/filesystems; echo "--- /dev/loop*"; ls -l /dev/loop* 2>&1
      echo "--- dmesg (tail)"; dmesg 2>&1 | tail -n 40; } >> "$TRACE" 2>/dev/null; sync; }
  sleep 1
done
trace "SYSTEM mounted on /sysroot after $n retries"

for d in flash proc sys dev; do mkdir -p "/sysroot/$d" 2>/dev/null; done
mount -o move /flash /sysroot/flash
mount -o move /proc  /sysroot/proc
mount -o move /sys   /sysroot/sys
mount -o move /dev   /sysroot/dev

for i in /usr/sbin/rgos-init /sbin/init; do
  [ -x "/sysroot$i" ] && { trace "switch_root to $i"; sync; [ -n "$LOGO_PID" ] && kill "$LOGO_PID" 2>/dev/null; exec switch_root /sysroot "$i"; }
done
trace "no init found in SYSTEM"; sync
say "no init found in SYSTEM"
while :; do sleep 3600; done
